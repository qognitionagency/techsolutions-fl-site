---
/**
 * Radio/checkbox choices for the booking form (design-spec-v3 §1.3 chip). Native inputs stay in
 * the accessibility tree and keyboard order; the label is the hit target.
 * `cards` = icon cards (steps 1 and 3: icons, never photos), `chips` = pills, `list` = rows.
 */
import Icon from './Icon.astro';
import type { IconName } from './icon-names';
interface Opt { key: string; label: string; icon?: IconName }
interface Props {
  name: string;
  type: 'radio' | 'checkbox';
  options: readonly Opt[];
  required?: boolean;
  variant?: 'chips' | 'cards' | 'list';
  idPrefix: string;
  /** cards per row from 640px */
  columns?: 2 | 3 | 4;
  /** Key of the option checked by default (radio). */
  checked?: string;
}
const { name, type, options, required = false, variant = 'chips', idPrefix, columns = 3, checked } = Astro.props;
---
<div class:list={['choices', `choices--${variant}`]} style={variant === 'cards' ? `--cols:${columns}` : undefined}>
  {options.map((o) => (
    <label class="choice" for={`${idPrefix}-${o.key}`}>
      <input
        class="choice__input"
        type={type}
        name={name}
        value={o.key}
        id={`${idPrefix}-${o.key}`}
        required={type === 'radio' && required ? true : undefined}
        checked={checked === o.key ? true : undefined}
      />
      {o.icon && <span class="choice__icon" aria-hidden="true"><Icon name={o.icon} size={22} /></span>}
      <span class="choice__label">{o.label}</span>
      <span class="choice__tick" aria-hidden="true"><Icon name="check" size={12} /></span>
    </label>
  ))}
</div>

<style>
  .choices { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .choices--cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
  .choices--list { display: grid; gap: var(--space-2); }

  .choice {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    line-height: var(--leading-ui);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard);
  }
  .choice:hover { background: var(--color-bg-alt); }
  .choice__input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .choice:has(.choice__input:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .choice:has(.choice__input:checked) { border-color: var(--color-accent); background: var(--color-surface-tint); color: var(--color-link-hover); box-shadow: inset 0 0 0 0.5px var(--color-accent); }
  .choice__tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    color: transparent;
    transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .choices--chips .choice__tick, .choices--list .choice__tick { order: -1; }
  .choice:has(input[type="radio"]) .choice__tick { border-radius: var(--radius-pill); }
  .choice:has(.choice__input:checked) .choice__tick { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }

  .choices--list .choice { width: 100%; border-radius: var(--radius-md); }

  .choices--cards .choice { border-radius: var(--radius-lg); min-height: 3.5rem; padding: var(--space-3); }
  .choice__icon { display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-md); background: var(--color-bg-alt); color: var(--color-text-muted); transition: color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard); }
  .choice:has(.choice__input:checked) .choice__icon { background: var(--color-surface); color: var(--color-accent); }
  .choices--cards .choice__tick { margin-left: auto; }

  @media (min-width: 640px) {
    .choices--cards { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .choices--cards .choice { flex-direction: column; align-items: flex-start; gap: var(--space-3); min-height: 7rem; padding: var(--space-4); }
    .choices--cards .choice__tick { position: absolute; top: var(--space-3); right: var(--space-3); }
  }
</style>
