---
/**
 * Section head (spec §1.2). Kicker row: mono EYEBROW │ the SEO H2 rendered small; then the
 * memorable display line (<p>, --text-3xl) and an optional lead. When a section's content has no
 * display line (its heading IS the memorable line, e.g. the quote builder), the H2 itself takes
 * the display size. Every string from content.ts.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  display?: string;
  lead?: string;
  id: string;
  align?: 'start' | 'center';
  /** Rendered after the H2 inside the kicker row (e.g. a Sample tag). */
  tag?: string;
}
const { eyebrow, heading, display, lead, id, align = 'start', tag } = Astro.props;
---
<header class:list={['shead', align === 'center' && 'shead--center']} data-reveal>
  <div class="shead__kicker">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {eyebrow && display && <span class="shead__rule" aria-hidden="true"></span>}
    {display && <h2 id={id} class="shead__h2s">{heading}</h2>}
    {tag && <span class="sample-tag">{tag}</span>}
  </div>
  {display ? <p class="shead__display">{display}</p> : <h2 id={id} class="shead__display">{heading}</h2>}
  {lead && <p class="lede">{lead}</p>}
</header>

<style>
  .shead { max-width: 52rem; }
  .shead__kicker { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .shead__kicker:empty { display: none; }
  .shead--center .shead__kicker { justify-content: center; }
  .shead__rule { width: 1px; height: var(--space-4); background: var(--color-line-strong); }
  .shead__h2s {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    letter-spacing: 0;
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .shead__display {
    margin: var(--space-3) 0 0;
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-heading);
    text-wrap: balance;
    max-width: 22ch;
  }
  .shead--center .shead__display { margin-inline: auto; }
  .shead :global(.lede) { margin-top: var(--space-4); }
  .shead--center :global(.lede) { margin-inline: auto; }
</style>
