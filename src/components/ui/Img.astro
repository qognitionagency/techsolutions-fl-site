---
/** Wraps astro:assets <Picture> (ADR §3): AVIF/WebP, srcset, width/height always set. */
import { Picture } from 'astro:assets';
import { getImage } from '../../lib/media';

interface Props {
  slot: string;
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  /** object-position for cover crops */
  position?: string;
}
const { slot, alt, sizes, widths = [480, 768, 1080, 1440, 1920], eager = false, class: cls, position } = Astro.props;
const src = getImage(slot);
const usable = widths.filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={usable}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding={eager ? 'sync' : 'async'}
  class={cls}
  style={position ? `object-position:${position}` : undefined}
/>
