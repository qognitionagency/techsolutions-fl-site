---
/**
 * Radio/checkbox group for the booking form, wired to form.ts's HTML contract
 * (data-field, data-error*, data-required-group). Labels and errors from content.ts.
 */
import type { Field } from '../../data/content';

interface Props {
  field: Field;
  type: 'radio' | 'checkbox';
  required?: boolean;
  checked?: string;
  layout?: 'chips' | 'stack';
  /** wraps in data-show-if */
  showIf?: string;
}
const { field, type, required = false, checked, layout = 'chips', showIf } = Astro.props;
const errs = field.errors ?? {};
const helperId = field.helper ? `f-${field.name}-help` : undefined;
---
<fieldset
  class:list={['choice', `choice-${layout}`]}
  data-field
  data-required-group={type === 'checkbox' && required ? '1' : undefined}
  data-error={errs.required}
  data-error-required={errs.required}
  data-show-if={showIf}
>
  <legend class="field-label">{field.label}</legend>
  {field.helper && <p class="field-help" id={helperId}>{field.helper}</p>}
  <div class="choice-options">
    {(field.options ?? []).map((o) => (
      <label class="opt" for={`f-${field.name}-${o.value}`}>
        <input
          id={`f-${field.name}-${o.value}`}
          type={type}
          name={field.name}
          value={o.value}
          required={type === 'radio' && required}
          checked={checked === o.value}
          aria-describedby={helperId}
        />
        <span>{o.label}</span>
      </label>
    ))}
  </div>
</fieldset>
