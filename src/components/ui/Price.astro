---
/** Mono price chip ("from $129 per TV") plus the visible Sample label Ruth requires on every sample price. */
import type { Price } from '../../data/content';
import { uiLabels } from '../../data/ui-labels';
interface Props { price: Price; class?: string }
const { price, class: cls } = Astro.props;
---
<span class:list={['price', cls]}>
  <span class="price-chip"><span class="price-chip__from">{price.prefix}</span>${price.amount.toLocaleString('en-US')}</span>
  {price.unit && <span class="price__unit">{price.unit}</span>}
  {price.sample && <span class="sample-tag">{uiLabels.sample}</span>}
</span>

<style>
  .price { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .price__unit { font-size: var(--text-xs); color: var(--color-text-muted); }
</style>
