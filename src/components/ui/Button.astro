---
/**
 * Every CTA on the page. Renders a content.ts `Cta` with the analytics attributes (ADR §6)
 * and the prefill attributes the two consumers read:
 *   href #book  → data-prefill-services / -property-type / -wires / -wall-type / -role (form.ts)
 *   href #quote → data-quote-services (quote.ts). Never data-prefill-*: form.ts would prefill the
 *                 booking form, fire form_start and pull focus into it from a "Price this" click.
 * Variants (spec §1.3): primary = signal blue, secondary = white with a 3:1 border,
 * text = link with an arrow, inverse = text link on the slate footer.
 */
import type { Cta } from '../../data/content';
import { withBase } from '../../lib/url';
import Icon from './Icon.astro';

interface Props {
  cta: Cta;
  /** Section key for data-track-location. */
  location: string;
  variant?: 'primary' | 'secondary' | 'text' | 'inverse';
  size?: 'md' | 'sm';
  icon?: 'arrow' | 'phone' | 'sms' | 'none';
  class?: string;
  /** Override the visible label (e.g. compact nav button). The full label stays the accessible name. */
  label?: string;
  /** Disambiguates the description id when one CTA renders more than once. */
  uid?: string;
  /** Extra data attributes (e.g. data-quote-book). */
  data?: Record<string, string>;
}

const { cta, location, variant = 'primary', size = 'md', icon, class: cls = '', label, uid, data = {} } = Astro.props;
const href = withBase(cta.href);
const toQuote = cta.href === '#quote';
const glyph =
  icon ??
  (cta.href.startsWith('tel:') ? 'phone' : cta.href.startsWith('sms:') ? 'sms' : variant === 'text' || variant === 'inverse' ? 'arrow' : 'none');
const p = cta.prefill;
const visible = label ?? cta.label;
// WCAG 2.5.3 Label in Name: the accessible name must contain the visible text. A short visible
// label (nav "Book") gets the full CTA label as its name; a longer aria-label that does not
// contain the visible text is demoted to a description.
const name = cta.ariaLabel ?? (label && label !== cta.label ? cta.label : undefined);
const nameOk = !name || name.toLowerCase().includes(visible.toLowerCase());
const descId = !nameOk ? `d-${cta.trackId}-${location}${uid ? `-${uid}` : ''}` : undefined;
const dataAttrs = Object.fromEntries(Object.entries(data).map(([k, v]) => [`data-${k}`, v]));
---
<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]}
  data-track={cta.track}
  data-track-id={cta.trackId}
  data-track-type={cta.kind}
  data-track-location={location}
  data-prefill-services={!toQuote ? p?.services?.join(',') : undefined}
  data-prefill-property-type={!toQuote ? p?.propertyType : undefined}
  data-prefill-wires={!toQuote ? p?.wires : undefined}
  data-prefill-wall-type={!toQuote ? p?.wallType : undefined}
  data-prefill-role={!toQuote ? p?.role : undefined}
  data-quote-services={toQuote ? p?.services?.join(',') : undefined}
  aria-label={nameOk ? name : undefined}
  aria-describedby={descId}
  target={cta.external ? '_blank' : undefined}
  rel={cta.external ? 'noopener' : undefined}
  {...dataAttrs}
>
  {glyph === 'phone' && <Icon name="phone" size={16} />}
  {glyph === 'sms' && <Icon name="sms" size={16} />}
  <span class="btn__label">{visible}</span>
  {descId && <span id={descId} class="visually-hidden">{cta.ariaLabel}</span>}
  {glyph === 'arrow' && <Icon name="arrow-right" size={16} class="btn__arrow" />}
</a>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-fg: var(--color-heading);
    --btn-border: transparent;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid var(--btn-border);
    border-radius: var(--radius-md);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      transform var(--duration-instant) var(--ease-standard);
  }
  .btn--sm { min-height: 2.5rem; padding: 0 var(--space-4); }
  .btn:active { transform: translateY(1px); }
  .btn:focus-visible { outline: none; box-shadow: var(--shadow-focus); }

  .btn--primary { --btn-bg: var(--color-accent); --btn-fg: var(--color-on-accent); box-shadow: var(--shadow-cta); }
  .btn--primary:hover { --btn-bg: var(--color-accent-hover); --btn-fg: var(--color-on-accent); }
  .btn--primary:focus-visible { box-shadow: var(--shadow-focus), var(--shadow-cta); }

  .btn--secondary { --btn-bg: var(--color-surface); --btn-border: var(--color-border-strong); --btn-fg: var(--color-heading); }
  .btn--secondary:hover { --btn-bg: var(--color-bg-alt); --btn-fg: var(--color-heading); }

  .btn--text, .btn--inverse { min-height: 2.75rem; padding: 0; border: 0; border-radius: var(--radius-xs); }
  .btn--text { color: var(--color-link); }
  .btn--text:hover { color: var(--color-link-hover); }
  .btn--inverse { color: var(--color-text-inverse); }
  .btn--inverse:hover { color: var(--color-signal-300); }
  .btn--text:focus-visible, .btn--inverse:focus-visible { box-shadow: none; outline: 2px solid var(--color-focus); outline-offset: 2px; }

  .btn :global(.btn__arrow) { transition: transform var(--duration-fast) var(--ease-out-quart); }
  .btn:hover :global(.btn__arrow), .btn:focus-visible :global(.btn__arrow) { transform: translateX(2px); }
</style>
