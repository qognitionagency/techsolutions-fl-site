---
/**
 * Layered parallax band (Iron Sound pattern): a full-bleed Miami plate and an inset
 * detail plate that travel at different rates. Decorative rhythm between sections
 * (alt=""): the sections around them carry the meaning.
 */
import Img from './Img.astro';
interface Props { back: string; front: string; side?: 'left' | 'right' }
const { back, front, side = 'right' } = Astro.props;
---
<div class:list={['band', `band--${side}`]} aria-hidden="true">
  <div class="band__back">
    <div class="band__plate" data-parallax="12">
      <Img slot={back} alt="" ratio={2} widths={[768, 1280, 1920, 2560]} sizes="100vw" quality={62} class="band__img" />
    </div>
  </div>
  <div class="band__front frame">
    <div class="band__inset" data-parallax="-10">
      <Img slot={front} alt="" ratio={4 / 5} widths={[360, 540, 720]} sizes="(min-width: 1024px) 24vw, 40vw" class="band__img" />
    </div>
  </div>
</div>

<style>
  .band { position: relative; height: clamp(20rem, 58vw, 42rem); }
  .band__back { position: absolute; inset: 0; overflow: hidden; background: var(--color-mist); }
  .band__plate { position: absolute; inset: -14% 0; }
  .band__plate :global(picture), .band__plate :global(.band__img),
  .band__inset :global(picture), .band__inset :global(.band__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band__front { position: relative; height: 100%; }
  .band__inset {
    position: absolute;
    bottom: -12%;
    width: clamp(9rem, 26vw, 22rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    outline: 2px solid var(--color-rule-signal);
    outline-offset: var(--space-2);
  }
  .band--right .band__inset { right: var(--space-gutter); }
  .band--left .band__inset { left: var(--space-gutter); }
  .band + :global(section) { padding-top: calc(var(--space-section) + 4rem); }
</style>
