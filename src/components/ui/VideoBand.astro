---
/**
 * Poster <Picture> with a muted looping video laid over it (ADR §7).
 * The <Picture> underneath is the poster and the LCP. The <video> carries no `poster`
 * attribute on purpose: a poster there becomes the LCP candidate (measured 3.4 s).
 * The video is decorative (aria-hidden) and
 * only gets its src from scripts/video.ts. A pause/play toggle satisfies WCAG 2.2.2.
 */
import Img from './Img.astro';
import { videoSrc } from '../../lib/media';
import { uiLabels } from '../../data/ui-labels';

interface Props {
  slot: string;
  alt?: string;
  sizes: string;
  hero?: boolean;
  position?: string;
  class?: string;
  /** parallax strength token for motion.ts (desktop yPercent) */
  parallax?: number;
}
const { slot, alt = '', sizes, hero = false, position = '50% 50%', class: cls, parallax } = Astro.props;
---
<div class:list={['vb', cls]} data-video-band>
  <div class="vb-media" data-parallax={parallax ? String(parallax) : undefined}>
    <Img slot={`${slot}-poster`} alt={alt} sizes={sizes} eager={hero} class="vb-poster" position={position} widths={[480, 768, 1080, 1440, 1920]} />
    <video
      class="vb-video"
      muted
      playsinline
      loop
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      data-src={videoSrc(slot)}
      data-video={hero ? 'hero' : 'lazy'}
      style={`object-position:${position}`}
    ></video>
  </div>
  <button
    type="button"
    class="vb-toggle"
    data-video-toggle
    data-label-pause={uiLabels.pauseVideo}
    data-label-play={uiLabels.playVideo}
    aria-label={uiLabels.pauseVideo}
    data-state="playing"
    hidden
  >
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" /></svg>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" /></svg>
  </button>
  <slot />
</div>

<style>
  .vb { position: relative; overflow: hidden; isolation: isolate; background: var(--color-mist); }
  .vb-media { position: absolute; inset: 0; }
  .vb-media[data-parallax] { inset: -15% 0; }
  .vb :global(picture), .vb :global(.vb-poster), .vb-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vb-video { opacity: 0; transition: opacity var(--duration-scene) var(--ease-standard); }
  .vb-video.is-playing { opacity: 1; }
  .vb-toggle {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-raised);
    display: grid;
    place-items: center;
    width: var(--space-7);
    height: var(--space-7);
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--color-surface) 60%, transparent);
    background: color-mix(in srgb, var(--color-slate) 45%, transparent);
    color: var(--color-surface);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .vb-toggle:hover { background: color-mix(in srgb, var(--color-slate) 65%, transparent); }
  .vb-toggle svg { width: var(--space-4); height: var(--space-4); fill: currentColor; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .vb-toggle .i-play { stroke-width: 1; }
  .vb-toggle[data-state='playing'] .i-play,
  .vb-toggle[data-state='paused'] .i-pause { display: none; }
</style>
