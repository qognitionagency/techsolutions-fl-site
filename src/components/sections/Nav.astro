---
/** Fixed glass header (Iron Sound port): concept ribbon + nav bar + mobile sheet. */
import { nav, ribbon } from '../../data/content';
import { uiLabels } from '../../data/ui-labels';
import { withBase } from '../../lib/url';
import Button from '../ui/Button.astro';
---
<header class="site-header" data-header>
  <p class="ribbon" title={ribbon.disclosure}>
    <span class="ribbon__mark" aria-hidden="true"></span>
    <span>{ribbon.text}</span>
  </p>
  <nav class="bar" aria-label={uiLabels.mainNav}>
    <div class="bar__inner frame">
      <a href="#top" class="bar__logo" aria-label={nav.logoLabel}>
        <img src={withBase('brand/logo-horizontal.svg')} alt="" width="438" height="58" />
      </a>

      <ul class="bar__links" role="list">
        {nav.links.map((l) => (
          <li><a href={l.href} class="bar__link" data-nav-link>{l.label}</a></li>
        ))}
      </ul>

      <div class="bar__actions">
        <a
          href={nav.phone.href}
          class="bar__phone"
          data-track={nav.phone.track}
          data-track-id={nav.phone.trackId}
          data-track-type={nav.phone.kind}
          data-track-location="nav"
          aria-label={nav.phone.ariaLabel}
        >{nav.phone.label}</a>
        <Button cta={nav.primary} location="nav" size="sm" icon="none" class="bar__book" magnetic />
        <button
          type="button"
          class="bar__menu"
          aria-expanded="false"
          aria-controls="nav-sheet"
          data-menu-toggle
          data-label-open={nav.menuOpen}
          data-label-close={nav.menuClose}
        >
          <span class="bar__menu-lines" aria-hidden="true"><span></span><span></span></span>
          <span class="bar__menu-label" data-menu-label>{nav.menuOpen}</span>
        </button>
      </div>
    </div>

    <div id="nav-sheet" class="sheet" data-menu-sheet hidden>
      <ul class="sheet__links frame" role="list">
        {nav.links.map((l, i) => (
          <li style={`--i:${i}`}><a href={l.href} class="sheet__link">{l.label}</a></li>
        ))}
        <li style={`--i:${nav.links.length}`} class="sheet__cta">
          <Button cta={nav.phone} location="nav" variant="secondary" />
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const sheet = header.querySelector<HTMLElement>('[data-menu-sheet]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;

  // Collapse the ribbon and firm up the bar once the page moves (transform only: no CLS).
  let scrolled = false;
  const onScroll = () => {
    const s = window.scrollY > 24;
    if (s !== scrolled) header.classList.toggle('is-scrolled', (scrolled = s));
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu: disclosure pattern. Esc closes, focus returns to the toggle.
  const setOpen = (open: boolean, restoreFocus = false) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    header.classList.toggle('is-open', open);
    if (open) {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.classList.add('is-open'));
      sheet.querySelector<HTMLAnchorElement>('a')?.focus();
    } else {
      sheet.classList.remove('is-open');
      sheet.hidden = true;
      if (restoreFocus) toggle.focus();
    }
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Where am I: mark the nav link for the section in view (aria-current="location").
  const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter((el): el is HTMLElement => !!el);
  const io = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        links.forEach((a) => (a.hash === `#${en.target.id}` ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  targets.forEach((t) => io.observe(t));
</script>

<style>
  .site-header {
    --ribbon-h: 2rem;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }
  .site-header.is-scrolled:not(.is-open) { transform: translateY(calc(-1 * var(--ribbon-h))); }

  /* Concept disclosure: signal-700 with white text (>7:1). Brand blue, never black. */
  .ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--ribbon-h);
    margin: 0;
    padding-inline: var(--space-gutter);
    background: var(--color-signal-700);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ribbon__mark { flex: none; width: var(--space-2); height: var(--space-2); border-radius: var(--radius-pill); background: var(--color-bay); }

  .bar {
    position: relative;
    background: var(--color-surface-glass-strong);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
  }
  .is-scrolled .bar { border-bottom-color: var(--color-border); box-shadow: var(--shadow-sm); }
  .bar__inner { display: flex; align-items: center; gap: var(--space-6); height: var(--nav-height); }
  .bar__logo { display: block; flex: none; padding-block: var(--space-2); border-radius: var(--radius-sm); }
  .bar__logo img { width: 9.5rem; height: auto; }
  @media (min-width: 768px) { .bar__logo img { width: 11rem; } }

  .bar__links { display: none; gap: var(--space-5); margin: 0 auto; padding: 0; list-style: none; }
  .bar__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    text-decoration: none;
    white-space: nowrap;
  }
  .bar__link::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 2px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-bay);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out-quart);
  }
  .bar__link:hover { color: var(--color-signal-700); }
  .bar__link:hover::after, .bar__link[aria-current]::after { transform: scaleX(1); }
  .bar__link[aria-current] { color: var(--color-signal-700); }

  .bar__actions { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  .bar__phone {
    display: none;
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
  }
  .bar__phone:hover { color: var(--color-signal-700); }

  .bar__menu {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-heading);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    cursor: pointer;
  }
  .bar__menu:focus-visible { outline: none; box-shadow: var(--shadow-focus); }
  .bar__menu-lines { display: grid; gap: 5px; width: 18px; }
  .bar__menu-lines span { display: block; height: 1.5px; background: currentColor; transition: transform var(--duration-base) var(--ease-out-quart); }
  .is-open .bar__menu-lines span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .is-open .bar__menu-lines span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* The compact Book button is hidden on the smallest phones; the sticky bar carries Book there. */
  .bar__actions :global(.bar__book) { display: none; }
  @media (min-width: 480px) { .bar__actions :global(.bar__book) { display: inline-flex; } }

  @media (min-width: 1024px) {
    .bar__links { display: flex; }
    .bar__menu { display: none; }
    .sheet { display: none; }
  }
  @media (min-width: 1280px) { .bar__phone { display: inline; } }

  .sheet {
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-lg);
    padding-block: var(--space-5) var(--space-6);
  }
  .sheet__links { display: grid; gap: var(--space-1); margin: 0; list-style: none; }
  .sheet__links li {
    opacity: 0;
    transform: translateY(var(--space-2));
    transition: opacity var(--duration-base) var(--ease-out-quart), transform var(--duration-base) var(--ease-out-quart);
    transition-delay: calc(var(--i) * 30ms);
  }
  .sheet.is-open .sheet__links li { opacity: 1; transform: none; }
  .sheet__link {
    display: block;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--tracking-heading);
    font-size: var(--text-xl);
    text-decoration: none;
  }
  .sheet__cta { padding-top: var(--space-4); }
</style>
