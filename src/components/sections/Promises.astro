---
/** Promises strip (replaces "Trust stats", operator ruling). No numbers, no ratings. Each is a sample. */
import { promises } from '../../data/content';
---
<section class="promises" aria-labelledby="promises-h2">
  <div class="container-x">
    <div class="promises-head">
      <h2 id="promises-h2" class="sr-only">{promises.srHeading}</h2>
      <span class="sample-tag">{promises.sampleLabel}</span>
      <!-- NEEDS DATA: all four promises confirmed or struck by Jay -->
    </div>
    <ol class="promises-list" data-reveal-group>
      {promises.items.map((p, i) => (
        <li class="promise" data-reveal>
          <span class="promise-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="promise-title">{p.title}</h3>
          <p class="promise-body">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .promises { padding-block: 0 var(--space-section); }
  .promises-head { display: flex; justify-content: flex-end; margin-bottom: var(--space-4); }
  .promises-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--color-border);
  }
  .promise {
    display: grid;
    align-content: start;
    grid-template-columns: var(--space-7) 1fr;
    column-gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .promise-n {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-signal-600);
    padding-top: 0.2em;
  }
  .promise-title { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  .promise-body { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }

  @media (min-width: 768px) {
    .promises-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  }
  @media (min-width: 1024px) {
    .promises-list { grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--color-border); }
    .promise { grid-template-columns: 1fr; border-bottom: 0; padding: var(--space-6) var(--space-5) var(--space-6) 0; }
    .promise + .promise { border-left: 1px solid var(--color-border); padding-left: var(--space-5); }
    .promise-n { grid-row: auto; margin-bottom: var(--space-5); }
  }
</style>
