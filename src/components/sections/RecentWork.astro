---
/**
 * Recent work, IG-style 3x2 grid. Stock images with a visible "Stock image, sample"
 * label (Ruth-gated copy). Tiles are not links: linking stock to Jay's Instagram
 * would imply the photos are his. The single IG link sits below the grid (cro-spec §2 row 7).
 */
import Img from '../ui/Img.astro';
import { recentWork as rw } from '../../data/content';
---
<section class="work section-y" id={rw.id} aria-labelledby="work-h2">
  <div class="container-x">
    <div class="work-head">
      <h2 id="work-h2" class="h-section" data-split>{rw.h2}</h2>
      <p class="lede">{rw.intro}</p>
    </div>
    <ul class="grid" data-reveal-group>
      {rw.items.map((w) => (
        <li class="tile" data-reveal>
          <figure>
            <div class="tile-media">
              <Img slot={w.slot} alt={w.alt} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw" widths={[360, 540, 760, 1080]} />
              <span class="tile-tag">{w.tag}</span>
              <span class="tile-label">{w.label}</span>
            </div>
            <figcaption>{w.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <!-- NEEDS DATA: Jay's own photos + permission -->
    <p class="work-out">
      <a href={rw.instagramLink.href} target="_blank" rel="noopener" data-track={rw.instagramLink.track} data-track-id={rw.instagramLink.trackId}>
        {rw.instagramLink.label}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
      </a>
    </p>
  </div>
</section>

<style>
  .work-head { display: grid; gap: var(--space-4); margin-bottom: var(--space-7); }
  .work-head .lede { margin: 0; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  .tile figure { margin: 0; display: grid; gap: var(--space-3); }
  .tile-media { position: relative; aspect-ratio: 1; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-mist); box-shadow: var(--shadow-sm); }
  .tile-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duration-scene) var(--ease-out-expo); }
  .tile:hover .tile-media :global(img) { transform: scale(1.04); }
  .tile-tag, .tile-label {
    position: absolute;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    line-height: 1.3;
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    color: var(--color-slate);
  }
  .tile-tag { top: var(--space-3); left: var(--space-3); font-weight: var(--font-weight-label); }
  .tile-label { bottom: var(--space-3); left: var(--space-3); font-family: var(--font-mono); color: var(--color-text-muted); }
  .tile figcaption { font-size: var(--text-sm); color: var(--color-text-muted); }
  .work-out { margin: var(--space-7) 0 0; }
  .work-out a { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: var(--font-weight-label); }
  .work-out svg { width: var(--space-4); height: var(--space-4); fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }

  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
    .work-head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-8); align-items: end; }
  }
</style>
