---
/**
 * Hero (design-spec-v3 §2.1, content.ts v3 copy). Left: eyebrow, H1, subhead, CTAs in
 * content order (quote first), the sample note and area line. Right: one framed stock photo
 * (approved: signature-tv-wall-after) with a white annotation card on it, and the live phone
 * mockup overlapping the frame's lower-left edge. The photo is the LCP element.
 */
import { hero, processSteps, quoteBuilder, services } from '../../data/content';
import { uiLabels } from '../../data/ui-labels';
import { usd } from '../../lib/quote';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import HeroPhone from './HeroPhone.astro';

const tv = services.tabs[0];
const tvLabel = quoteBuilder.services.find((s) => s.key === 'tv')?.label ?? tv.title;
// Second layered card: the "installed and tested" checklist (processSteps step 3), shown on desktop.
const tested = processSteps.steps.find((s) => s.micro.kind === 'checklist');
const checklist = tested?.micro.kind === 'checklist' ? tested.micro : null;
---
<section class="hero" data-hero aria-labelledby="hero-h1">
  <div class="hero__bg dotgrid" aria-hidden="true"></div>
  <div class="frame grid12 hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-h1" class="hero__h1">{hero.heading}</h1>
      <p class="hero__sub">{hero.subhead}</p>
      <div class="hero__ctas" data-hero-ctas>
        <Button cta={hero.primary} location="hero" />
        <Button cta={hero.secondary} location="hero" variant="secondary" />
      </div>
      <ul class="hero__strip" role="list">
        <li><Icon name="price" size={16} /><span>{hero.note}</span></li>
        <li><Icon name="pin" size={16} /><span>{hero.areaLine}</span></li>
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__photo">
        <Img
          slot="signature-tv-wall-after"
          alt=""
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 42vw, 92vw"
          priority
          class="hero__img"
        />
        <div class="anno" aria-hidden="true">
          <p class="anno__k">{tv.price.sample && <span class="sample-tag">{uiLabels.sample}</span>}<span>{tvLabel}</span></p>
          <p class="anno__v mono">{tv.price.prefix} {usd(tv.price.amount)}</p>
          {tv.price.unit && <p class="anno__u">{tv.price.unit}</p>}
        </div>
        <span class="sample-tag hero__stock">{uiLabels.stockPhoto}</span>
      </div>
      <div class="hero__phone"><HeroPhone /></div>
      {tested && checklist && (
        <div class="check-card" aria-hidden="true">
          <p class="check-card__h"><span>{tested.heading}</span>{checklist.sample && <span class="sample-tag">{uiLabels.sample}</span>}</p>
          <ul>
            {checklist.items.map((it) => (
              <li><span class="check-card__tick"><Icon name="check" size={12} /></span><span>{it.label}</span><span class="check-card__v mono">{it.value}</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: calc(var(--nav-height) + var(--space-8)) var(--space-section); overflow: clip; }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-bg);
    /* Mask alpha only (#000 = opaque), not a colour: fades the dot grid toward the copy. */
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 72% 40%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 72% 40%, #000 30%, transparent 75%);
  }
  .hero__grid { align-items: center; row-gap: var(--space-8); }

  .hero__copy { display: grid; justify-items: start; gap: var(--space-5); }
  .hero__h1 {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 13ch;
  }
  .hero__sub { margin: 0; font-size: var(--text-lg); line-height: var(--leading-body); color: var(--color-text-muted); max-width: var(--measure-lead); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .hero__strip { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin: var(--space-2) 0 0; padding: var(--space-4) 0 0; list-style: none; border-top: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted); max-width: 34rem; }
  .hero__strip li { display: flex; align-items: flex-start; gap: var(--space-2); line-height: var(--leading-ui); }
  .hero__strip :global(.icon) { margin-top: 1px; color: var(--color-signal-600); }

  /* Visual: photo frame with the phone overlapping its lower-left edge (spec §2.1). On desktop
     the visual's pieces sit on the hero's own 12-col grid (display: contents), so the copy is
     centred on the photo frame, not on frame + phone. */
  .hero__visual { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero__photo {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-surface-sunken);
    box-shadow: var(--shadow-md);
  }
  .hero__photo :global(picture), .hero__photo :global(.hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; }
  .hero__stock { position: absolute; right: var(--space-3); bottom: var(--space-3); }
  .hero__phone { grid-column: 1; grid-row: 1; align-self: start; justify-self: center; margin-top: 46%; position: relative; z-index: 2; }
  .hero__phone :global(.hp) { --device-width: clamp(15rem, 12rem + 8vw, 17rem); }

  .check-card { display: none; }

  .anno {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .anno p { margin: 0; }
  .anno__k { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: var(--font-weight-label); color: var(--color-text-muted); }
  .anno__v { font-size: var(--text-2xl); font-weight: var(--font-weight-data); letter-spacing: -0.02em; line-height: 1.15; color: var(--color-price); }
  .anno__u { font-size: var(--text-xs); color: var(--color-text-muted); }

  @media (max-width: 767px) {
    .hero { padding-top: calc(var(--nav-height) + var(--space-7)); }
    .hero__ctas { display: grid; width: 100%; }
    .hero__ctas :global(.btn) { width: 100%; }
    .hero__photo { aspect-ratio: 4 / 3; border-radius: var(--radius-xl); }
    .anno { top: var(--space-3); right: var(--space-3); padding: var(--space-2) var(--space-3); }
    .anno__v { font-size: var(--text-xl); }
    .hero__stock { right: auto; bottom: auto; left: var(--space-3); top: var(--space-3); }
  }
  /* Phone and tablet: the device shrinks (zoom keeps its screens in proportion) and overlaps
     the photo's lower-left corner; the caption sits beside it and the switcher runs full width
     underneath at normal size, so its tap targets stay 40px+. */
  @media (max-width: 1023px) {
    .hero__grid { row-gap: var(--space-7); }
    .hero__copy { gap: var(--space-4); }
    .hero__phone { justify-self: stretch; margin-top: 50%; padding-left: var(--space-4); }
    .hero__phone :global(.hp) { grid-template-columns: auto minmax(0, 1fr); align-items: end; justify-items: start; column-gap: var(--space-4); }
    .hero__phone :global(.hp__device) { zoom: 0.56; }
    .hero__phone :global(.hp__cap) { grid-column: 2; grid-row: 1; text-align: left; padding-bottom: var(--space-2); }
    .hero__phone :global(.hp__switch) { grid-column: 1 / -1; justify-self: center; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero__visual { max-width: 36rem; justify-self: center; width: 100%; }
    .hero__phone :global(.hp__device) { zoom: 0.7; }
  }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-rows: auto auto; align-items: start; row-gap: 0; }
    .hero__visual { display: contents; }
    .hero__copy { grid-column: 1 / span 6; grid-row: 1; align-self: center; padding-right: var(--space-6); }
    .hero__photo { grid-column: 7 / -1; grid-row: 1; }
    .hero__phone { grid-column: 7 / span 4; grid-row: 1 / span 2; justify-self: start; margin-top: 38%; margin-left: calc(-1 * var(--space-7)); }
    .hero__h1 { font-size: min(var(--text-4xl), 8svh); }
    .check-card {
      grid-column: 10 / -1;
      grid-row: 2;
      align-self: start;
      position: relative;
      z-index: 1;
      display: grid;
      gap: var(--space-2);
      margin-top: calc(-1 * var(--space-10));
      margin-right: calc(-1 * var(--space-5));
      padding: var(--space-4);
      border-radius: var(--radius-xl);
      background: var(--color-surface);
      box-shadow: var(--shadow-lg);
    }
    .check-card p, .check-card ul { margin: 0; padding: 0; list-style: none; }
    .check-card__h { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); font-size: var(--text-sm); font-weight: var(--font-weight-heading); color: var(--color-heading); }
    .check-card li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-2); padding-block: var(--space-2); border-top: 1px solid var(--color-border); font-size: var(--text-sm); }
    .check-card__tick { display: grid; place-items: center; width: 1.125rem; height: 1.125rem; border-radius: var(--radius-pill); background: var(--color-success); color: var(--color-on-accent); }
    .check-card__v { font-size: var(--text-xs); color: var(--color-success); }
  }
  /* Desktop and laptop: the whole composition (copy, photo, phone and its switcher) fits the
     first screen. The phone scales with the window height; zoom keeps its screens in proportion. */
  @media (min-width: 1024px) and (max-height: 1000px) {
    .hero { padding-top: calc(var(--nav-height) + var(--space-7)); }
    .hero__phone :global(.hp__device) { zoom: 0.86; }
  }
  @media (min-width: 1024px) and (max-height: 900px) { .hero__phone :global(.hp__device) { zoom: 0.76; } }
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero__photo { aspect-ratio: 4 / 3; }
    .hero__phone :global(.hp__device) { zoom: 0.66; }
    .hero__phone :global(.hp__cap) { display: none; }
  }
  @media (min-width: 1024px) and (max-height: 700px) { .hero__phone :global(.hp__device) { zoom: 0.58; } }
  /* Short browser windows (a 720–768px laptop screen minus browser chrome): the photo's height
     follows the width, so it is capped here too, the phone tucks higher over it, and the
     decorative checklist card (aria-hidden) drops out. */
  @media (min-width: 1024px) and (max-height: 660px) {
    .hero__photo { aspect-ratio: auto; height: calc(100svh - var(--nav-height) - var(--space-7) - 6rem); }
    .hero__phone { margin-top: 18%; }
    .hero__phone :global(.hp__device) { zoom: 0.5; }
    .check-card { display: none; }
  }
</style>
