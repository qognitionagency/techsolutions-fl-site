---
/**
 * Hero (Iron Sound port). The display kicker sits above the only H1, which carries the
 * services (operator: service-led; Jay is a small byline). LCP = the poster picture
 * (ADR §7). Mobile: 4:5 crop, panel overlaps below. Desktop: full-bleed 16:9 with a
 * glass panel on the left. video.ts assigns the clip's src after load + idle.
 */
import { getImage } from 'astro:assets';
import { anchors, hero } from '../../data/content';
import { uiLabels } from '../../data/ui-labels';
import { poster, videoSrc } from '../../lib/media';
import Button from '../ui/Button.astro';

const src = poster('hero-tv-wall');

interface Crop { ratio: number; position: string; widths: number[]; quality: number }
async function srcset(format: 'avif' | 'webp', crop: Crop): Promise<string> {
  const max = Math.max(...crop.widths);
  const img = await getImage({ src, format, widths: crop.widths, width: max, height: Math.round(max / crop.ratio), fit: 'cover', position: crop.position, quality: crop.quality });
  return img.srcSet.attribute;
}
const mobile: Crop = { ratio: 4 / 5, position: 'center', widths: [480, 640, 828, 1080], quality: 55 };
const desktop: Crop = { ratio: 16 / 9, position: 'center', widths: [1024, 1440, 1920], quality: 62 };
const mAvif = await srcset('avif', mobile);
const mWebp = await srcset('webp', mobile);
const dAvif = await srcset('avif', desktop);
const dWebp = await srcset('webp', desktop);
const fallback = await getImage({ src, format: 'jpg', width: 1440, height: 810, fit: 'cover', quality: 70 });
---
<section id={anchors.top} class="hero" aria-labelledby="hero-heading" data-hero>
  <div class="hero__media">
    <picture>
      <source media="(max-width: 767px)" type="image/avif" srcset={mAvif} sizes="100vw" />
      <source media="(max-width: 767px)" type="image/webp" srcset={mWebp} sizes="100vw" />
      <source type="image/avif" srcset={dAvif} sizes="100vw" />
      <source type="image/webp" srcset={dWebp} sizes="100vw" />
      <img class="hero__poster" src={fallback.src} alt={hero.posterAlt} width="1440" height="810" fetchpriority="high" loading="eager" decoding="sync" />
    </picture>
    <video class="hero__video" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" data-hero-video data-src={videoSrc('hero-tv-wall')}></video>
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__layout frame">
    <div class="hero__panel">
      <p class="eyebrow hero__area">{hero.areaLine}</p>
      <p class="display hero__kicker">{hero.kicker}</p>
      <h1 id="hero-heading" class="hero__h1">{hero.heading}</h1>
      <p class="hero__sub">{hero.subhead}</p>
      <div class="hero__ctas">
        <Button cta={hero.primary} location="hero" magnetic icon="arrow" />
        <Button cta={hero.secondary} location="hero" variant="secondary" />
      </div>
      {hero.byline && (
        <p class="hero__byline">
          <span>{hero.byline.text}</span>
          {hero.byline.sample && <span class="sample-tag">{uiLabels.sample}</span>}
        </p>
      )}
    </div>
  </div>

  <button type="button" class="hero__motion" data-video-toggle data-label-pause={uiLabels.pauseVideo} data-label-play={uiLabels.playVideo} aria-pressed="false" hidden>
    <svg class="i-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="1.6" /></svg>
    <svg class="i-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3l8 5-8 5Z" fill="currentColor" /></svg>
    <span class="visually-hidden" data-video-toggle-label>{uiLabels.pauseVideo}</span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: max(40rem, 100svh);
    max-height: 68rem;
    padding-top: calc(var(--nav-height) + 2rem);
    overflow: clip;
    background: var(--color-mist);
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media picture, .hero__poster, .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* ADR §7, the video is never the LCP. Desktop: the hero fills the viewport, and Chrome skips
     viewport-sized images as background, so the video must stay exactly poster-sized to be skipped
     too (2px shorter made it the only candidate; Owen, 2026-10-07). Mobile: see the media query. */
  .hero__video { opacity: 0; transition: opacity var(--duration-scene) var(--ease-in-out); }
  .hero__video:global(.is-playing) { opacity: 1; }
  /* Legibility only: lifts the left of the frame under the glass panel. */
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(to right, color-mix(in srgb, var(--color-cloud) 40%, transparent), transparent 55%); }

  .hero__layout { display: flex; align-items: center; padding-bottom: var(--space-8); }
  .hero__panel {
    position: relative;
    width: 100%;
    max-width: 38rem;
    padding: var(--space-7);
    background: var(--color-surface-glass);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    border: 1px solid color-mix(in srgb, var(--color-surface) 60%, transparent);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-glass);
  }
  .hero__panel::before {
    content: "";
    position: absolute;
    top: -1px;
    left: var(--space-7);
    width: var(--space-8);
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-bay);
    box-shadow: var(--shadow-signal-glow);
  }
  .hero__area { margin: 0 0 var(--space-4); }
  .hero__kicker { margin: 0; font-size: calc(var(--text-4xl) * 0.82); max-width: 15ch; }
  .hero__h1 {
    margin: var(--space-5) 0 0;
    max-width: 34ch;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-label);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }
  .hero__sub { margin: var(--space-3) 0 0; color: var(--color-text-muted); max-width: 48ch; font-size: var(--text-sm); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .hero__byline { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: var(--space-5) 0 0; padding-top: var(--space-4); border-top: 1px solid var(--color-border); font-size: var(--text-xs); color: var(--color-text-muted); }

  .hero__motion {
    position: absolute;
    right: var(--space-gutter);
    bottom: var(--space-5);
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--color-heading);
    cursor: pointer;
  }
  .hero__motion:focus-visible { outline: none; box-shadow: var(--shadow-focus); }
  .hero__motion .i-play { display: none; }
  .hero__motion[aria-pressed="true"] .i-play { display: block; }
  .hero__motion[aria-pressed="true"] .i-pause { display: none; }

  @media (max-width: 767px) {
    .hero { display: block; min-height: 0; max-height: none; padding-top: calc(var(--nav-height) + 2rem); background: var(--color-bg); }
    .hero__media { position: relative; inset: auto; z-index: 0; height: 58svh; min-height: 22rem; }
    /* Mobile: the poster is the LCP; 2px shorter keeps the video's first frame from out-sizing it. */
    .hero__video { height: calc(100% - 2px); }
    .hero__scrim { display: none; }
    .hero__layout { position: relative; z-index: 1; margin-top: -5rem; padding-bottom: var(--space-7); }
    .hero__panel { padding: var(--space-6) var(--space-5); background: var(--color-surface-glass-strong); }
    .hero__panel::before { left: var(--space-5); }
    .hero__kicker { font-size: var(--text-3xl); }
    .hero__motion { top: calc(var(--nav-height) + 2.75rem); bottom: auto; }
  }
</style>
