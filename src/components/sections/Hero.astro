---
/**
 * Hero + "What do you need done?" picker (cro-spec §3, art-direction §5.1).
 * Native radios = arrow-key navigation for free. Without JS all four result
 * cards render stacked; JS collapses them to the selected one.
 * The poster <Picture> is the LCP; the video fades in after load + idle.
 */
import VideoBand from '../ui/VideoBand.astro';
import Button from '../ui/Button.astro';
import Price from '../ui/Price.astro';
import { hero, contact, stickyBar } from '../../data/content';

const { picker } = hero;
const icons: Record<string, string> = {
  'icon-tv': '<rect x="3" y="5" width="18" height="11" rx="1.5"/><path d="M9 20h6M12 16v4"/>',
  'icon-wifi': '<path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.2a9.5 9.5 0 0 1 13 0M8.6 15.4a5 5 0 0 1 6.8 0"/><circle cx="12" cy="18.6" r="1"/>',
  'icon-camera': '<path d="M3 8.5 15.5 5l1.5 5.5L4.5 14z"/><path d="M17 8.2 21 7v5l-3.4-.4M7 13.5 8 19H5"/>',
  'icon-smart': '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><circle cx="12" cy="9" r="2.2"/><path d="M10 15h4M10 17.5h4"/>',
};
---
<section class="hero" aria-labelledby="hero-h1">
  <div class="hero-grid container-x">
    <div class="hero-copy">
      <p class="eyebrow">{hero.kicker}</p>
      <!-- NEEDS DATA: Jay to confirm same-visit multi-service (H1) -->
      <h1 id="hero-h1" class="h-display hero-h1" data-split>{hero.h1}</h1>
      <p class="lede hero-sub">{hero.sub}</p>
      <div class="jay">
        <!-- NEEDS DATA: photo of Jay + permission. Initials until then, never a stock face. -->
        <span class="jay-avatar" aria-hidden="true">{hero.jay.name.slice(0, 1)}</span>
        <span class="jay-text"><strong>{hero.jay.name}</strong><span>{hero.jay.role}</span></span>
      </div>
    </div>

    <div class="hero-media">
      <VideoBand
        slot="hero-tv-wall"
        alt={hero.posterAlt}
        hero
        sizes="(min-width: 1024px) 58vw, 100vw"
        position="52% 50%"
        class="hero-video"
      />
    </div>

    <div class="hero-picker">
      <div class="picker" data-picker data-sms-base={contact.smsBase} data-sticky-body={stickyBar.smsBody}>
        <fieldset class="picker-set">
          <legend class="picker-legend">{picker.legend}</legend>
          <div class="chips">
            {picker.options.map((o) => (
              <label class="chip">
                <input type="radio" name="picker-service" value={o.id} checked={o.id === picker.defaultId} />
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[o.iconSlot] ?? ''} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="results" aria-live="polite">
          {picker.options.map((o) => (
            <div class="result" data-result={o.id} data-name={o.name}>
              <div class="result-head">
                <p class="result-name">{o.name}</p>
                <Price price={o.fromPrice} size="lg" />
              </div>
              {o.alsoFrom && (
                <p class="result-also">
                  <span>{o.alsoFrom.label}</span>
                  <span class="mono">{o.alsoFrom.price.prefix} ${o.alsoFrom.price.amount}</span>
                </p>
              )}
              <ul class="result-includes">
                {o.includes.map((i) => (
                  <li>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>
                    {i}
                  </li>
                ))}
              </ul>
              <div class="result-actions">
                <Button link={o.cta} variant="book" size="lg" block magnetic service={o.id} prefill={{ services: o.id }} data-entry="picker" />
                <a class="text-link" href={o.textLink.href} data-track={o.textLink.track} data-track-id={o.textLink.trackId} data-service={o.id}>
                  {o.textLink.label}
                </a>
              </div>
            </div>
          ))}
        </div>
        <p class="sample-note"><span class="sample-dot" aria-hidden="true"></span>{picker.sampleNote}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';

  const root = document.querySelector<HTMLElement>('[data-picker]');
  if (root) {
    root.setAttribute('data-enhanced', '');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="picker-service"]'));
    const results = Array.from(root.querySelectorAll<HTMLElement>('[data-result]'));
    let viaPointer = false;

    const show = (id: string) => {
      for (const r of results) r.hidden = r.dataset.result !== id;
      // Sticky bar "Text" carries the chosen service (content.ts stickyBar note).
      const name = results.find((r) => r.dataset.result === id)?.dataset.name;
      const base = root.dataset.smsBase ?? '';
      const body = root.dataset.stickyBody ?? '';
      const sticky = document.querySelector<HTMLAnchorElement>('[data-sticky-text]');
      if (sticky && name && body) sticky.href = base + encodeURIComponent(body.replace('a TV / Wi-Fi / camera job', name.replace(/^(Camera|Smart)/, (m) => m.toLowerCase())));
    };

    root.addEventListener('pointerdown', () => (viaPointer = true));
    root.addEventListener('keydown', () => (viaPointer = false));
    for (const r of radios) {
      r.addEventListener('change', () => {
        if (!r.checked) return;
        show(r.value);
        track('picker_select', { service: r.value, method: viaPointer ? 'click' : 'keyboard' });
      });
    }

    // ?service=… preselect (read once, never written back; no picker_select event).
    const param = new URLSearchParams(location.search).get('service');
    const pre = radios.find((r) => r.value === param);
    if (pre) pre.checked = true;
    show(radios.find((r) => r.checked)?.value ?? radios[0]!.value);
  }
</script>

<style>
  .hero { padding-block: var(--space-6) var(--space-7); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .hero-copy { display: grid; gap: var(--space-5); align-content: start; }
  .hero-h1 { max-width: 15ch; }
  .hero-sub { margin: 0; }

  .jay { display: inline-flex; align-items: center; gap: var(--space-3); }
  .jay-avatar {
    display: grid;
    place-items: center;
    width: var(--space-7);
    height: var(--space-7);
    border-radius: var(--radius-pill);
    background: var(--color-signal-100);
    color: var(--color-signal-700);
    font-weight: var(--font-weight-heading);
    box-shadow: 0 0 0 3px var(--color-surface), var(--shadow-sm);
  }
  .jay-text { display: grid; line-height: 1.25; font-size: var(--text-sm); }
  .jay-text span { color: var(--color-text-muted); }

  .hero-media { position: relative; }
  .hero-media :global(.hero-video) { aspect-ratio: 16 / 9; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); }

  .hero-picker { position: relative; z-index: var(--z-raised); margin-top: calc(-1 * var(--space-8)); padding-inline: var(--space-2); }

  .picker {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .picker-set { border: 0; margin: 0; padding: 0; min-width: 0; }
  .picker-legend {
    padding: 0;
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-heading);
  }
  .chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .chip {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: calc(var(--spacing) * 13);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-cloud);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    line-height: 1.2;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
  }
  .chip:hover { border-color: var(--color-signal-300); background: var(--color-surface); }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip svg { flex: none; width: var(--space-5); height: var(--space-5); fill: none; stroke: var(--color-steel-ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .chip:has(input:checked) {
    border-color: var(--color-signal-500);
    background: var(--color-signal-50);
    box-shadow: inset 0 0 0 1px var(--color-signal-500);
  }
  .chip:has(input:checked) svg { stroke: var(--color-signal-600); }
  .chip:has(input:focus-visible) { box-shadow: var(--shadow-focus); }

  .results { display: grid; gap: var(--space-6); }
  .result { display: grid; gap: var(--space-4); }
  .picker[data-enhanced] .result:not([hidden]) { animation: result-in var(--duration-slow) var(--ease-out-expo); }
  @keyframes result-in { from { opacity: 0; transform: translateY(var(--space-2)); } }

  .result-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .result-name { margin: 0; font-size: var(--text-xl); font-weight: var(--font-weight-heading); letter-spacing: var(--tracking-heading); }
  .result-also {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-sunset-100);
    font-size: var(--text-sm);
  }
  .result-also .mono { font-family: var(--font-mono); color: var(--color-price); font-weight: var(--font-weight-heading); white-space: nowrap; }
  .result-includes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); font-size: var(--text-sm); }
  .result-includes li { display: grid; grid-template-columns: var(--space-4) 1fr; gap: var(--space-2); align-items: start; }
  .result-includes svg { width: var(--space-4); height: var(--space-4); margin-top: 0.15em; fill: none; stroke: var(--color-success); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .result-actions { display: grid; gap: var(--space-3); justify-items: center; }
  .text-link { font-size: var(--text-sm); font-weight: var(--font-weight-label); }

  .sample-note { display: flex; align-items: center; gap: var(--space-2); margin: 0; font-size: var(--text-xs); color: var(--color-text-muted); border-top: 1px dashed var(--color-border); padding-top: var(--space-3); }
  .sample-dot { width: var(--space-2); height: var(--space-2); border-radius: var(--radius-pill); background: var(--color-sunset); flex: none; }

  @media (min-width: 640px) {
    .chips { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .chip { flex-direction: column; align-items: flex-start; justify-content: space-between; min-height: calc(var(--spacing) * 20); padding: var(--space-3); }
    .hero-picker { padding-inline: var(--space-6); }
    .picker { padding: var(--space-6); }
  }

  @media (min-width: 1024px) {
    .hero { padding-top: var(--space-8); }
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: var(--space-6);
      row-gap: var(--space-7);
    }
    .hero-copy { grid-column: 1 / 7; grid-row: 1; padding-top: var(--space-6); }
    .hero-media { grid-column: 7 / 13; grid-row: 1 / 3; }
    .hero-media :global(.hero-video) { aspect-ratio: auto; height: 100%; min-height: calc(var(--spacing) * 180); border-radius: var(--radius-2xl); }
    .hero-picker { grid-column: 1 / 9; grid-row: 2; align-self: end; margin: 0 0 var(--space-7); padding: 0; }
    .chip { min-height: calc(var(--spacing) * 22); }
  }
</style>
