---
/** FAQ (Iron Sound port): question = H3 inside <summary>, answer = the <p> after it. Text bound to FAQPage JSON-LD. */
import { anchors, faq } from '../../data/content';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id={anchors.faq} class="section faq" aria-labelledby="faq-heading">
  <div class="frame faq__grid">
    <div class="faq__side">
      <SectionHead display={faq.display} heading={faq.heading} id="faq-heading" align="stack" />
      <div class="faq__ctas">
        <Button cta={faq.primary} location="faq" variant="secondary" />
        <Button cta={faq.secondary} location="faq" variant="text" />
      </div>
    </div>
    <div class="faq__list">
      {faq.items.map((q, i) => (
        <details class="qa" data-faq-id={q.id} name="faq">
          <summary class="qa__q">
            <span class="qa__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="qa__h3">{q.question}</h3>
            <span class="qa__icon" aria-hidden="true"></span>
          </summary>
          <div class="qa__a">
            <p>{q.answer}</p>
            {q.link && <Button cta={q.link} location="faq" variant="text" />}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';
  for (const d of document.querySelectorAll<HTMLDetailsElement>('details[data-faq-id]')) {
    d.addEventListener('toggle', () => {
      if (d.open) track('faq_open', { faq_id: d.dataset.faqId });
    });
  }
</script>

<style>
  .faq { background: var(--color-bg); }
  .faq__grid { display: grid; gap: var(--space-7); }
  .faq__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); }
  .faq__list { border-top: 2px solid var(--color-slate); }
  .qa { border-bottom: 1px solid var(--color-border); }
  .qa__q { display: grid; grid-template-columns: var(--space-7) minmax(0, 1fr) var(--space-6); align-items: center; gap: var(--space-3); padding: var(--space-5) 0; list-style: none; }
  .qa__q:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .qa__n { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-signal-600); }
  .qa__h3 { margin: 0; font-size: var(--text-lg); line-height: 1.3; transition: color var(--duration-fast) var(--ease-standard); }
  .qa__q:hover .qa__h3 { color: var(--color-signal-700); }
  /* Plus becomes minus: says open/closed. */
  .qa__icon { position: relative; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-surface); transition: background-color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard); }
  .qa__icon::before, .qa__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; background: var(--color-heading); transform: translate(-50%, -50%); transition: transform var(--duration-base) var(--ease-out-quart); }
  .qa__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .qa[open] .qa__icon { background: var(--color-signal-50); border-color: var(--color-signal-200); }
  .qa[open] .qa__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .qa__a { padding: 0 var(--space-6) var(--space-6) var(--space-8); color: var(--color-text-muted); max-width: calc(var(--measure) + var(--space-8)); }
  .qa__a p { margin: 0 0 var(--space-3); }
  .qa[open] .qa__a { animation: qa-in var(--duration-base) var(--ease-out-quart); }
  @keyframes qa-in { from { opacity: 0; transform: translateY(-4px); } }

  @media (max-width: 767px) {
    .qa__q { grid-template-columns: minmax(0, 1fr) var(--space-6); }
    .qa__n { display: none; }
    .qa__a { padding-left: 0; padding-right: 0; }
  }
  @media (min-width: 1024px) {
    .faq__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-9); align-items: start; }
    .faq__side { position: sticky; top: calc(var(--nav-height) + var(--space-6)); }
  }
</style>
