---
/**
 * FAQ: <details>/<summary> with the question as an H3 (seo-spec §3). The answer
 * text is in the HTML at load. The same content.ts strings feed FAQPage JSON-LD
 * (lib/schema.ts). faq_open fires per open with the slug (cro-spec §5).
 */
import { faq } from '../../data/content';
---
<section class="faq section-y" id={faq.id} aria-labelledby="faq-h2">
  <div class="container-x faq-grid">
    <header class="faq-head">
      <h2 id="faq-h2" class="h-section" data-split>{faq.h2}</h2>
      <div class="faq-links">
        <a class="btn-like" href={faq.textLink.href} data-track={faq.textLink.track} data-track-id={faq.textLink.trackId}>{faq.textLink.label}</a>
        <a href={faq.callLink.href} data-track={faq.callLink.track} data-track-id={faq.callLink.trackId}>{faq.callLink.label}</a>
        <!-- NEEDS DATA: Jay's real phone -->
      </div>
    </header>
    <div class="faq-list">
      {faq.items.map((f) => (
        <details class="qa" data-faq-id={f.id}>
          <summary>
            <h3>{f.q}</h3>
            <span class="qa-icon" aria-hidden="true"></span>
          </summary>
          <div class="qa-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';
  for (const d of document.querySelectorAll<HTMLDetailsElement>('details[data-faq-id]')) {
    d.addEventListener('toggle', () => d.open && track('faq_open', { faq_id: d.dataset.faqId }));
  }
</script>

<style>
  .faq-grid { display: grid; gap: var(--space-7); }
  .faq-head { display: grid; gap: var(--space-5); align-content: start; }
  .faq-links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .faq-links a { font-weight: var(--font-weight-label); }
  .btn-like {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-7);
    padding-inline: var(--space-5);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1.5px var(--color-signal-500);
    background: var(--color-surface);
    color: var(--color-signal-700);
    text-decoration: none;
  }
  .btn-like:hover { background: var(--color-signal-50); }

  .faq-list { border-top: 1px solid var(--color-border); }
  .qa { border-bottom: 1px solid var(--color-border); }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-sm);
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa h3 { margin: 0; font-size: var(--text-lg); font-weight: var(--font-weight-label); }
  .qa summary:hover h3 { color: var(--color-signal-700); }
  .qa-icon {
    position: relative;
    flex: none;
    width: var(--space-6);
    height: var(--space-6);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: transform var(--duration-base) var(--ease-out-quart), background-color var(--duration-fast) var(--ease-standard);
  }
  .qa-icon::before, .qa-icon::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: var(--space-3);
    height: 1.5px;
    background: var(--color-slate);
    transform: translate(-50%, -50%);
  }
  .qa-icon::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform var(--duration-base) var(--ease-out-quart); }
  .qa[open] .qa-icon { background: var(--color-signal-50); border-color: var(--color-signal-200); }
  .qa[open] .qa-icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .qa-a { padding-bottom: var(--space-5); }
  .qa-a p { margin: 0; max-width: var(--measure); color: var(--color-text-muted); }

  @media (min-width: 1024px) {
    .faq-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-8); }
    .faq-head { position: sticky; top: calc(var(--spacing) * 28); align-self: start; }
  }
</style>
