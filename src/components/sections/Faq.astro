---
/**
 * FAQ (#faq; design-spec-v3 §2.8, content.ts faq). Narrow, centred head, <details> accordion
 * with hairline rows and no cards. Question = H3 inside <summary>; the answer text is bound to
 * the FAQPage JSON-LD (lib/schema.ts) — rendered verbatim, never edited here.
 */
import { anchors, faq } from '../../data/content';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id={anchors.faq} class="section faq" aria-labelledby="faq-heading">
  <div class="frame frame--narrow">
    <SectionHead eyebrow={faq.eyebrow} heading={faq.heading} display={faq.display} id="faq-heading" align="center" />
    <div class="faq__list">
      {faq.items.map((q) => (
        <details class="qa" data-faq-id={q.id} name="faq">
          <summary class="qa__q">
            <h3 class="qa__h3">{q.question}</h3>
            <span class="qa__icon" aria-hidden="true"></span>
          </summary>
          <div class="qa__a">
            <p>{q.answer}</p>
            {q.link && <Button cta={q.link} location="faq" variant="text" uid={q.id} />}
          </div>
        </details>
      ))}
    </div>
    <div class="faq__ctas">
      <Button cta={faq.primary} location="faq" />
      <Button cta={faq.secondary} location="faq" variant="secondary" />
    </div>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';
  for (const d of document.querySelectorAll<HTMLDetailsElement>('details[data-faq-id]')) {
    d.addEventListener('toggle', () => {
      if (d.open) track('faq_open', { faq_id: d.dataset.faqId });
    });
  }
</script>

<style>
  .faq__list { border-bottom: 1px solid var(--color-border); }
  .qa { border-top: 1px solid var(--color-border); }
  .qa__q { display: grid; grid-template-columns: minmax(0, 1fr) 1.25rem; align-items: center; gap: var(--space-4); padding-block: var(--space-5); list-style: none; border-radius: var(--radius-xs); }
  .qa__q:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .qa__h3 { font-size: var(--text-lg); font-weight: var(--font-weight-label); line-height: var(--leading-ui); letter-spacing: var(--tracking-title); transition: color var(--duration-fast) var(--ease-standard); }
  .qa__q:hover .qa__h3 { color: var(--color-link); }
  .qa__icon { position: relative; width: 1.25rem; height: 1.25rem; transition: transform var(--duration-base) var(--ease-out-quart); }
  .qa__icon::before, .qa__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; border-radius: 1px; background: var(--color-heading); transform: translate(-50%, -50%); }
  .qa__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .qa[open] .qa__icon { transform: rotate(45deg); }
  .qa__a { padding-bottom: var(--space-5); color: var(--color-text-muted); max-width: var(--measure); }
  .qa__a p { margin: 0 0 var(--space-2); }
  .qa[open] .qa__a { animation: qa-in var(--duration-base) var(--ease-out-quart); }
  @keyframes qa-in { from { opacity: 0; transform: translateY(-4px); } }
  .faq__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-7); }
</style>
