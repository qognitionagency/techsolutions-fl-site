---
/**
 * Sticky Call | Text | Get a quote bar (< 768px; design-spec-v3 §2.11, content.ts stickyBar).
 * Fixed, so it never shifts layout. With JS it slides in once the hero CTAs leave the viewport
 * and steps aside while the quote builder or the booking form is in view, or a field has focus. Without JS it stays.
 */
import { stickyBar } from '../../data/content';
import Button from '../ui/Button.astro';
---
<nav class="mbar" aria-label={stickyBar.label} data-mbar>
  <Button cta={stickyBar.call} location="mobilebar" variant="secondary" class="mbar__btn" />
  <Button cta={stickyBar.text} location="mobilebar" variant="secondary" class="mbar__btn" />
  <Button cta={{ ...stickyBar.quote, ariaLabel: stickyBar.quoteAria }} location="mobilebar" class="mbar__btn" />
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const ctas = document.querySelector('[data-hero-ctas]');
  const book = document.querySelector('[data-consult]');
  const quote = document.querySelector('[data-qb]');
  if (bar && ctas) {
    let pastHero = false;
    let atForm = false;
    let typing = false;
    let atQuote = false;
    const sync = () => {
      // Steps aside in the quote builder (its own sticky total takes over) and at the form.
      const show = pastHero && !atForm && !atQuote && !typing;
      bar.classList.toggle('is-shown', show);
      bar.inert = !show;
    };
    bar.classList.add('is-js');
    new IntersectionObserver(([e]) => ((pastHero = !e!.isIntersecting && e!.boundingClientRect.top < 0), sync())).observe(ctas);
    if (quote) new IntersectionObserver(([e]) => ((atQuote = e!.isIntersecting), sync()), { rootMargin: '-30% 0px -30% 0px' }).observe(quote);
    if (book) new IntersectionObserver(([e]) => ((atForm = e!.isIntersecting), sync()), { threshold: 0.4 }).observe(book);
    const isField = (el: Element | null) => !!el?.matches?.('input,select,textarea');
    document.addEventListener('focusin', (e) => ((typing = isField(e.target as Element)), sync()));
    document.addEventListener('focusout', () => setTimeout(() => ((typing = isField(document.activeElement)), sync()), 0));
    sync();
  }
</script>

<style>
  .mbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-mobile-bar);
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    transition: transform var(--duration-base) var(--ease-out-expo), visibility 0s linear var(--duration-base);
  }
  .mbar.is-js { transform: translateY(110%); visibility: hidden; }
  .mbar.is-js.is-shown { transform: none; visibility: visible; transition: transform var(--duration-base) var(--ease-out-expo), visibility 0s; }
  .mbar :global(.mbar__btn) { width: 100%; padding-inline: var(--space-2); }
  @media (min-width: 768px) { .mbar { display: none; } }
</style>
