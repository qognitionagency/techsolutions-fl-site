---
/**
 * Sticky Call | Text | Book bar (<1024px, cro-spec §2: 25/25/50). Fixed, so it never
 * shifts layout. With JS it appears once the hero has left the viewport and steps aside
 * while the booking form is in view or a field has focus. Without JS it stays visible.
 */
import { stickyBar } from '../../data/content';
import Button from '../ui/Button.astro';
---
<nav class="mbar" aria-label={stickyBar.label} data-mbar>
  <Button cta={stickyBar.call} location="mobilebar" variant="secondary" class="mbar__btn mbar__btn--call" />
  <Button cta={stickyBar.text} location="mobilebar" variant="secondary" class="mbar__btn" />
  <Button cta={{ ...stickyBar.book, ariaLabel: stickyBar.bookAria }} location="mobilebar" class="mbar__btn" icon="none" />
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const hero = document.querySelector('[data-hero]');
  const book = document.getElementById('book');
  if (bar && hero) {
    let pastHero = false;
    let atForm = false;
    let typing = false;
    const sync = () => {
      const show = pastHero && !atForm && !typing;
      bar.classList.toggle('is-shown', show);
      bar.inert = !show;
    };
    bar.classList.add('is-js');
    new IntersectionObserver(([e]) => ((pastHero = !e!.isIntersecting), sync()), { rootMargin: '-30% 0px 0px 0px' }).observe(hero);
    // The form section is taller than the viewport on phones: "in view" = it covers the middle of the screen.
    if (book) new IntersectionObserver(([e]) => ((atForm = e!.isIntersecting), sync()), { rootMargin: '-35% 0px -35% 0px' }).observe(book);
    const isField = (el: Element | null) => !!el?.matches?.('input,select,textarea');
    document.addEventListener('focusin', (e) => ((typing = isField(e.target as Element)), sync()));
    // Deferred: moving between two fields fires focusout then focusin; never flash the bar in between.
    document.addEventListener('focusout', () => setTimeout(() => ((typing = isField(document.activeElement)), sync()), 0));
    sync();
  }
</script>

<style>
  .mbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-mobile-bar);
    display: grid;
    grid-template-columns: 1fr 1fr 2fr;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--color-surface-glass-strong);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    border-top: 1px solid var(--color-border);
    transition: transform var(--duration-slow) var(--ease-out-expo), visibility 0s linear var(--duration-slow);
  }
  .mbar.is-js { transform: translateY(110%); visibility: hidden; }
  .mbar.is-js.is-shown { transform: none; visibility: visible; transition: transform var(--duration-slow) var(--ease-out-expo), visibility 0s; }
  .mbar :global(.mbar__btn) { width: 100%; padding-inline: var(--space-2); }
  @media (min-width: 1024px) { .mbar { display: none; } }
</style>
