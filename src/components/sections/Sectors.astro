---
/**
 * Condo / House / Office switcher (Iron Sound Sectors port). WAI-ARIA tabs, automatic
 * activation, arrows + Home/End. Panels share one grid cell so a switch crossfades.
 * Without JS every panel renders stacked and the tablist stays hidden. A tab click
 * never prefills the form; only the panel CTA does (property_type).
 */
import { anchors, sectors } from '../../data/content';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id={anchors.sectors} class="section sectors" aria-labelledby="sectors-heading">
  <div class="frame">
    <SectionHead display={sectors.display} heading={sectors.heading} id="sectors-heading" />

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label={sectors.tablistLabel} data-tablist hidden>
        {sectors.panels.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${p.id}`}
            aria-controls={`panel-${p.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tabs__tab"
            data-env={p.id}
          >
            <span class="tabs__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {p.tabLabel}
          </button>
        ))}
        <span class="tabs__ink" aria-hidden="true" data-ink></span>
      </div>

      <div class="tabs__panels">
        {sectors.panels.map((p, i) => (
          <div class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} data-panel>
            <div class="panel__media">
              <Img slot={p.media.slot} alt={p.media.alt} ratio={4 / 3} widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 56vw, 100vw" class="panel__img" />
            </div>
            <div class="panel__body">
              <h3 class="eyebrow panel__h3">{p.heading}</h3>
              <p class="display panel__headline">{p.headline}</p>
              <p class="panel__opener">{p.opener}</p>
              <ul class="panel__list" role="list">
                {p.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {p.note && <p class="panel__note">{p.note}</p>}
              <div class="panel__ctas">
                <Button cta={p.cta} location="environment" magnetic={i === 0} uid={p.id} />
                <Button cta={p.secondary} location="environment" variant="text" uid={p.id} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';

  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-tablist]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const ink = root.querySelector<HTMLElement>('[data-ink]')!;
    let current = 0;
    let leaveTimer = 0;

    root.classList.add('is-enhanced');
    list.hidden = false;
    panels.forEach((p, i) => (p.hidden = i !== 0));

    const moveInk = () => {
      const t = tabs[current]!;
      ink.style.setProperty('--x', `${t.offsetLeft}px`);
      ink.style.setProperty('--w', `${t.offsetWidth}px`);
    };

    const select = (i: number, method: 'pointer' | 'keyboard', focus = false) => {
      if (i === current) return;
      const prev = panels[current]!;
      const next = panels[i]!;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      window.clearTimeout(leaveTimer);
      panels.forEach((p) => p !== prev && p !== next && ((p.hidden = true), p.removeAttribute('data-leaving')));
      // Outgoing panel stays painted underneath (inert, hidden from AT) while the new one fades in.
      prev.setAttribute('data-leaving', '');
      prev.inert = true;
      prev.setAttribute('aria-hidden', 'true');
      next.hidden = false;
      next.inert = false;
      next.removeAttribute('aria-hidden');
      next.removeAttribute('data-leaving');
      leaveTimer = window.setTimeout(() => {
        prev.hidden = true;
        prev.removeAttribute('data-leaving');
        prev.removeAttribute('aria-hidden');
        prev.inert = false;
      }, 700);
      current = i;
      moveInk();
      if (focus) tabs[i]!.focus();
      track('environment_select', { environment: tabs[i]!.dataset.env, method });
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i, 'pointer')));
    list.addEventListener('keydown', (e) => {
      const n = tabs.length;
      const map: Record<string, number> = { ArrowRight: (current + 1) % n, ArrowLeft: (current - 1 + n) % n, Home: 0, End: n - 1 };
      if (!(e.key in map)) return;
      e.preventDefault();
      select(map[e.key]!, 'keyboard', true);
    });

    moveInk();
    new ResizeObserver(moveInk).observe(list);
  }
</script>

<style>
  .sectors { background: var(--color-surface); border-block: 1px solid var(--color-border); }

  .tabs__list {
    position: relative;
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs__tab {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: 3rem;
    padding: var(--space-3) var(--space-4) var(--space-4) 0;
    margin-right: var(--space-5);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--tracking-heading);
    font-size: var(--text-xl);
    cursor: pointer;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .tabs__tab:hover, .tabs__tab[aria-selected="true"] { color: var(--color-heading); }
  .tabs__tab:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  .tabs__index { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--font-weight-label); color: var(--color-signal-600); }
  /* Ink bar slides to the selected tab: shows where the selection moved. */
  .tabs__ink {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: var(--w, 0);
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-signal-500);
    transform: translateX(var(--x, 0));
    transition: transform var(--duration-slow) var(--ease-out-expo), width var(--duration-slow) var(--ease-out-expo);
  }
  @media (max-width: 479px) { .tabs__tab { font-size: var(--text-lg); margin-right: var(--space-2); padding-right: var(--space-2); } }

  .tabs__panels { display: grid; gap: var(--space-9); }
  .is-enhanced .tabs__panels { gap: 0; }
  .is-enhanced .panel { grid-area: 1 / 1; }
  .panel[data-leaving] { display: grid; z-index: 0; }
  .is-enhanced .panel:not([hidden]):not([data-leaving]) { z-index: 1; }
  .is-enhanced .panel:not([hidden]):not([data-leaving]) .panel__media { animation: media-in var(--duration-slow) var(--ease-in-out) both; }
  .is-enhanced .panel:not([hidden]):not([data-leaving]) .panel__body > * { animation: body-in var(--duration-slow) var(--ease-out-expo) both; }
  .is-enhanced .panel:not([hidden]):not([data-leaving]) .panel__body > :nth-child(2) { animation-delay: 60ms; }
  .is-enhanced .panel:not([hidden]):not([data-leaving]) .panel__body > :nth-child(n + 3) { animation-delay: 120ms; }
  .panel[data-leaving] .panel__body { opacity: 0; transition: opacity var(--duration-fast) var(--ease-in); }
  @keyframes media-in { from { opacity: 0; transform: scale(1.03); } }
  @keyframes body-in { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) {
    .is-enhanced .panel .panel__media, .is-enhanced .panel .panel__body > * { animation: none !important; }
  }

  .panel { display: grid; gap: var(--space-6); background: var(--color-surface); }
  .panel__media { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-xl); background: var(--color-mist); box-shadow: var(--shadow-md); }
  .panel__media :global(picture), .panel__media :global(.panel__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .panel__h3 { margin: 0; }
  .panel__headline { margin: var(--space-3) 0 0; font-size: var(--text-2xl); max-width: 20ch; }
  .panel__opener { margin: var(--space-4) 0 0; max-width: var(--measure); }
  .panel__list { display: grid; gap: var(--space-3); margin: var(--space-5) 0 0; padding: 0; list-style: none; color: var(--color-text-muted); font-size: var(--text-sm); }
  .panel__list li { display: grid; grid-template-columns: var(--space-5) 1fr; }
  .panel__list li::before { content: ""; width: var(--space-2); height: var(--space-2); margin-top: 0.5em; border-radius: var(--radius-pill); background: var(--color-bay); }
  .panel__note { margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--color-text-muted); }
  .panel__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-6); }

  @media (min-width: 1024px) {
    .panel { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-8); align-items: center; }
  }
</style>
