---
/** Footer (Iron Sound port): NAP, nav, concept disclosure, Pexels credit + authors (API terms). Light, never black. */
import { footer } from '../../data/content';
import { uiLabels } from '../../data/ui-labels';
import { stockAuthors } from '../../lib/media';
import { withBase } from '../../lib/url';
import Button from '../ui/Button.astro';

const authors = stockAuthors();
---
<footer class="footer">
  <div class="frame footer__grid">
    <div class="footer__brand">
      <img src={withBase('brand/logo-horizontal.svg')} alt={footer.nap.name} width="438" height="58" loading="lazy" class="footer__logo" />
      <p class="footer__tag">{footer.tagline}</p>
    </div>

    <address class="footer__nap">
      <span class="footer__name">{footer.contactHeading}</span>
      <Button cta={footer.nap.text} location="footer" variant="text" icon="none" />
      <Button cta={footer.nap.phone} location="footer" variant="text" icon="none" />
      <Button cta={footer.nap.email} location="footer" variant="text" icon="none" />
      <Button cta={footer.nap.instagram} location="footer" variant="text" icon="none" />
      <span class="footer__area">{footer.nap.area}</span>
      {footer.hours && <span>{footer.hours}</span>}
      {footer.spanish && <span>{footer.spanish}</span>}
    </address>

    <nav class="footer__nav" aria-label={uiLabels.footerNav}>
      <ul role="list">
        {footer.links.map((l) => <li><a href={l.href} class="link-draw">{l.label}</a></li>)}
        <li><a href="#top" class="link-draw">{footer.backToTop}</a></li>
      </ul>
    </nav>
  </div>

  <div class="frame footer__fine">
    <p class="footer__concept">{footer.concept}</p>
    <p>
      <a href={footer.credits.pexels.href} rel="noopener" target="_blank" class="link-draw">{footer.credits.pexels.label}</a>.
      {' '}{footer.credits.authorsPrefix}{' '}
      {authors.map((a, i) => (
        <>
          <a href={a.authorUrl} rel="noopener" target="_blank" class="link-draw">{a.author}</a>{i < authors.length - 2 ? ', ' : i === authors.length - 2 ? ' and ' : '.'}
        </>
      ))}
    </p>
    <p>{footer.trademarks}</p>
    <p>{footer.conceptCredit} · {footer.legal}</p>
  </div>
</footer>

<style>
  .footer { padding-block: var(--space-9) var(--space-7); background: var(--color-mist); border-top: 2px solid var(--color-bay); font-size: var(--text-sm); }
  .footer__grid { display: grid; gap: var(--space-7); }
  .footer__logo { width: 12rem; height: auto; }
  .footer__tag { margin: var(--space-4) 0 0; max-width: 36ch; color: var(--color-text); }
  .footer__nap { display: grid; justify-items: start; gap: 0; font-style: normal; color: var(--color-text); }
  .footer__nap :global(.btn--text) { min-height: 2.25rem; }
  .footer__name { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .footer__area { margin-top: var(--space-2); color: var(--color-text-muted); }
  .footer__nav ul { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .footer__nav a { color: var(--color-heading); }
  .footer__fine { display: grid; gap: var(--space-3); margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--color-mist-strong); color: var(--color-text-muted); font-size: var(--text-xs); line-height: 1.6; }
  .footer__fine p { margin: 0; max-width: 110ch; }
  .footer__fine a { color: var(--color-slate); }
  .footer__concept { color: var(--color-heading); font-weight: var(--font-weight-label); }
  @media (min-width: 768px) { .footer__grid { grid-template-columns: 1.3fr 1fr 0.8fr; } }
  @media (max-width: 1023px) { .footer { padding-bottom: calc(var(--space-7) + var(--mobilebar-height) + env(safe-area-inset-bottom)); } }
</style>
