---
/** Footer: contact, area, sample notice, Pexels credit + authors (API terms), concept credit. Light, not black. */
import { footer } from '../../data/content';
import { creditAuthors } from '../../lib/media';
import { withBase } from '../../lib/url';
const authors = creditAuthors();
---
<footer class="footer">
  <div class="container-x">
    <div class="footer-top">
      <div class="footer-brand">
        <img src={withBase('brand/logo-horizontal.svg')} alt="" width="438" height="58" />
        <p>{footer.tagline}</p>
      </div>
      <div class="footer-col">
        <h2>{footer.contactHeading}</h2>
        <ul>
          {footer.links.map((l) => <li><a href={l.href} data-track={l.track} data-track-id={l.trackId}>{l.label}</a></li>)}
          <li><a href={footer.instagram.href} target="_blank" rel="noopener" data-track={footer.instagram.track} data-track-id={footer.instagram.trackId}>{footer.instagram.label}</a></li>
        </ul>
        <!-- NEEDS DATA: Jay's real phone, mobile and email -->
      </div>
      <div class="footer-col">
        <h2>{footer.areaHeading}</h2>
        <p>{footer.areaLine}</p>
        {footer.hours && <p>{footer.hours}</p>}
        {footer.spanish && <p>{footer.spanish}</p>}
        <!-- NEEDS DATA: hours, Spanish-language service, service radius -->
      </div>
    </div>
    <p class="footer-notice">{footer.sampleNotice}</p>
    <div class="footer-bottom">
      <p class="credits">
        <a href={footer.pexelsCredit.href} target="_blank" rel="noopener">{footer.pexelsCredit.label}</a>:
        {authors.map((a, i) => (
          <>
            <a href={a.authorUrl} target="_blank" rel="noopener">{a.author}</a>{i < authors.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
      <p>{footer.conceptCredit}</p>
      <p>{footer.legal}</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-mist); border-top: 1px solid var(--color-mist-strong); padding-block: var(--space-9) var(--space-7); font-size: var(--text-sm); }
  .footer-top { display: grid; gap: var(--space-7); padding-bottom: var(--space-7); border-bottom: 1px solid var(--color-mist-strong); }
  .footer-brand img { width: calc(var(--spacing) * 48); height: auto; margin-bottom: var(--space-4); }
  .footer-brand p { margin: 0; max-width: 36ch; color: var(--color-text-muted); }
  .footer-col h2 { margin: 0 0 var(--space-3); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--font-weight-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-text-muted); }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .footer-col p { margin: 0; }
  .footer-col a { color: var(--color-slate); overflow-wrap: anywhere; }
  .footer-col a:hover { color: var(--color-link); }
  .footer-notice { margin: var(--space-6) 0; padding: var(--space-4); border-radius: var(--radius-md); border: 1px dashed var(--color-border-strong); color: var(--color-slate); max-width: 80ch; }
  .footer-bottom { display: grid; gap: var(--space-2); color: var(--color-text-muted); font-size: var(--text-xs); }
  .footer-bottom p { margin: 0; }
  .footer-bottom a { color: var(--color-steel-ink); }
  @media (min-width: 768px) {
    .footer-top { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 1023px) { .footer { padding-bottom: calc(var(--space-7) + var(--mobile-bar-height)); } }
</style>
