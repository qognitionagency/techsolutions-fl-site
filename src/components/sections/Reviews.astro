---
/** Reviews: samples, each visibly labelled. No Review/AggregateRating schema (seo-spec §5). */
import Button from '../ui/Button.astro';
import { reviews } from '../../data/content';
---
<section class="reviews section-y" id={reviews.id} aria-labelledby="reviews-h2">
  <div class="container-x">
    <div class="reviews-head">
      <h2 id="reviews-h2" class="h-section" data-split>{reviews.h2}</h2>
      <p class="sample-tag">{reviews.subhead}</p>
    </div>
    <!-- NEEDS DATA: real reviews Jay can share -->
    <ul class="list" data-reveal-group>
      {reviews.items.map((r) => (
        <li class="review" data-reveal>
          <figure>
            <blockquote><p>{r.quote}</p></blockquote>
            <figcaption>
              <span class="who"><strong>{r.firstName}</strong>, {r.neighborhood}</span>
              <span class="what">{r.service}</span>
              <span class="sample-tag">{r.label}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <div class="reviews-cta">
      <Button link={reviews.cta} variant="book" size="lg" magnetic data-entry="section" />
    </div>
  </div>
</section>

<style>
  .reviews { background: var(--color-signal-50); border-block: 1px solid var(--color-signal-100); }
  .reviews-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-7); }
  .reviews-head .sample-tag { margin: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .review figure {
    height: 100%;
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-size: var(--text-lg); line-height: 1.45; letter-spacing: -0.01em; color: var(--color-slate); }
  blockquote p::before { content: "\201C"; color: var(--color-signal-500); }
  blockquote p::after { content: "\201D"; color: var(--color-signal-500); }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); font-size: var(--text-sm); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .what { color: var(--color-text-muted); }
  figcaption .sample-tag { margin-left: auto; }
  .reviews-cta { margin-top: var(--space-7); }

  @media (min-width: 1024px) { .list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
