---
/**
 * Signature: "Same wall. Wires gone." (Iron Sound's Day→Dusk stage, ported as a drag slider).
 * One "after" photo; the "before" is an SVG overlay on the same frame: one power cord
 * hanging from the TV to an outlet (content.ts beforeAfter, MARS alignment). The wipe clips
 * the overlay. motion.ts draws the cord and scrubs the wipe to 50% on scroll until the
 * visitor takes the slider. Keyboard: role="slider", arrows / PageUp / PageDown / Home / End.
 * Coordinates are on the photo's 900x600 grid (TV x205–670 y52–320, bench top y418,
 * soundbar x283–573 y405–420); the outlet sits below the bench between its legs.
 * Without JS: the after photo with the overlay at 50%, the copy and the CTA render.
 */
import { anchors, beforeAfter as ba } from '../../data/content';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';

// Entirely in the left half, so the whole "before" reads at the resting 50% wipe.
const cord = 'M418 321 C416 360 386 392 368 421 C356 440 349 456 347 470 L346 487';
---
<section id={anchors.lighting} class="section signature" aria-labelledby="ba-heading">
  <div class="frame">
    <SectionHead display={ba.display} heading={ba.heading} id="ba-heading">
      <p>{ba.body}</p>
    </SectionHead>
  </div>

  <div class="signature__wrap frame">
    <figure class="stage" data-ba-stage>
      <div class="stage__frame" data-ba style="--pos: 50%">
        <Img slot="signature-tv-wall-after" alt={ba.states.after.alt} ratio={3 / 2} widths={[640, 960, 1280, 1600, 2000]} sizes="(min-width: 1536px) 1440px, 94vw" class="stage__img" />

        <div class="stage__before" data-ba-before>
          <svg class="stage__svg" viewBox="0 0 900 600" preserveAspectRatio="xMidYMid slice" role="img" aria-label={ba.states.before.alt}>
            <defs><filter id="ba-soft" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="3" /></filter></defs>
            <rect class="outlet" x="331" y="476" width="30" height="40" rx="3" />
            <rect class="outlet__slot" x="340" y="497" width="3" height="8" rx="1" />
            <rect class="outlet__slot" x="349" y="497" width="3" height="8" rx="1" />
            <path class="cord-shadow" d={cord} filter="url(#ba-soft)" transform="translate(5 7)" />
            <path class="cord" d={cord} pathLength="1" data-cord />
            <rect class="plug" x="340" y="481" width="12" height="13" rx="2" />
          </svg>
        </div>

        <p class="stage__note">{ba.illustrationNote}</p>

        <div class="stage__divider" aria-hidden="true"></div>
        <div
          class="stage__handle"
          role="slider"
          tabindex="0"
          aria-label={ba.sliderAriaLabel}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-valuetext={`${ba.states.before.label} 50%`}
          data-ba-handle
          data-label-before={ba.states.before.label}
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 7 4 12l5 5M15 7l5 5-5 5" /></svg>
        </div>

        <div class="stage__control" aria-hidden="true">
          <span class="stage__opt stage__opt--before">{ba.states.before.label}</span>
          <span class="stage__control-label">{ba.controlLabel}</span>
          <span class="stage__opt stage__opt--after">{ba.states.after.label}</span>
        </div>
      </div>

      <figcaption class="stage__caption">
        <span class="stage__state" aria-live="polite" data-ba-caption data-before={ba.states.before.caption} data-after={ba.states.after.caption}>{ba.states.before.caption}</span>
        <Button cta={ba.cta} location="slider" magnetic icon="arrow" />
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';

  const frame = document.querySelector<HTMLElement>('[data-ba]');
  const handle = frame?.querySelector<HTMLElement>('[data-ba-handle]');
  const caption = document.querySelector<HTMLElement>('[data-ba-caption]');
  if (frame && handle) {
    let used = false;
    let side: 'before' | 'after' | '' = '';
    const label = handle.dataset.labelBefore ?? '';

    const set = (pct: number) => {
      const p = Math.max(0, Math.min(100, pct));
      frame.style.setProperty('--pos', `${p}%`);
      const r = Math.round(p);
      handle.setAttribute('aria-valuenow', String(r));
      handle.setAttribute('aria-valuetext', `${label} ${r}%`);
      // Caption names what the larger share of the frame shows; announced only when it flips.
      const now = p >= 50 ? 'before' : 'after';
      if (caption && now !== side) {
        side = now;
        caption.textContent = caption.dataset[now] ?? '';
        frame.dataset.side = now;
      }
    };
    const firstUse = (method: 'pointer' | 'keyboard') => {
      frame.dataset.user = '';
      if (used) return;
      used = true;
      track('slider_use', { method });
    };
    const fromX = (x: number) => {
      const b = frame.getBoundingClientRect();
      set(((x - b.left) / b.width) * 100);
    };

    // motion.ts drives the intro wipe through this event until the visitor takes over.
    frame.addEventListener('ba:set', (e) => {
      if (!('user' in frame.dataset)) set((e as CustomEvent<number>).detail);
    });

    frame.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as Element).closest('a')) return;
      firstUse('pointer');
      frame.setPointerCapture(e.pointerId);
      frame.dataset.dragging = '';
      fromX(e.clientX);
      handle.focus({ preventScroll: true });
    });
    // A mouse drag that starts on the handle or the photo otherwise begins a native image drag,
    // which fires pointercancel and drops the gesture after the first move (Owen, 2026-10-07).
    frame.addEventListener('dragstart', (e) => e.preventDefault());
    frame.addEventListener('pointermove', (e) => 'dragging' in frame.dataset && fromX(e.clientX));
    const end = () => delete frame.dataset.dragging;
    frame.addEventListener('pointerup', end);
    frame.addEventListener('pointercancel', end);

    handle.addEventListener('keydown', (e) => {
      const now = Number(handle.getAttribute('aria-valuenow'));
      const step: Record<string, number> = { ArrowLeft: -2, ArrowDown: -2, ArrowRight: 2, ArrowUp: 2, PageDown: -10, PageUp: 10 };
      let next: number | null = null;
      if (e.key in step) next = now + step[e.key]!;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = 100;
      if (next === null) return;
      e.preventDefault();
      firstUse('keyboard');
      frame.dataset.snap = '';
      set(next);
      setTimeout(() => delete frame.dataset.snap, 300);
    });
    set(50);
  }
</script>

<style>
  .signature { background: var(--color-bg); }
  .signature__wrap { max-width: calc(var(--container-wide) + 2 * var(--space-gutter)); }
  .stage { margin: 0; }
  .stage__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-xl);
    background: var(--color-mist);
    box-shadow: var(--shadow-lg);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
  }
  .stage__frame :global(picture), .stage__frame :global(.stage__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .stage__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .stage__svg { width: 100%; height: 100%; }
  .stage__svg .cord { fill: none; stroke: var(--color-slate); stroke-width: 3.4; stroke-linecap: round; }
  .stage__svg .cord-shadow { fill: none; stroke: color-mix(in srgb, var(--color-slate) 22%, transparent); stroke-width: 4; stroke-linecap: round; }
  .stage__svg .outlet { fill: var(--color-surface); stroke: var(--color-mist-strong); stroke-width: 1.5; }
  .stage__svg .outlet__slot { fill: var(--color-steel); }
  .stage__svg .plug { fill: var(--color-slate); }

  .stage__frame[data-snap] .stage__before, .stage__frame[data-snap] .stage__divider, .stage__frame[data-snap] .stage__handle { transition: all var(--duration-base) var(--ease-in-out); }

  .stage__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    transform: translateX(-1px);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-slate) 12%, transparent), 0 0 18px color-mix(in srgb, var(--color-bay) 60%, transparent);
    pointer-events: none;
  }
  .stage__handle {
    position: absolute;
    top: 50%;
    left: var(--pos);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-signal-600);
    box-shadow: var(--shadow-md), 0 0 0 4px color-mix(in srgb, var(--color-bay) 35%, transparent);
    cursor: grab;
    transition: transform var(--duration-base) var(--ease-spring);
  }
  .stage__handle svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .stage__handle:hover, .stage__frame[data-dragging] .stage__handle { transform: translate(-50%, -50%) scale(1.06); }
  .stage__frame[data-dragging] .stage__handle { cursor: grabbing; }
  .stage__handle:focus-visible { outline: none; box-shadow: var(--shadow-md), var(--shadow-focus); }

  .stage__note {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    max-width: calc(100% - 2 * var(--space-4));
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface-glass-strong);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    pointer-events: none;
  }

  .stage__control {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface-glass-strong);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: var(--shadow-glass);
    white-space: nowrap;
    pointer-events: none;
  }
  .stage__control-label { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-signal-700); }
  .stage__opt { padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); font-size: var(--text-sm); font-weight: var(--font-weight-label); color: var(--color-text-muted); transition: background-color var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard); }
  .stage__frame[data-side="before"] .stage__opt--before,
  .stage__frame[data-side="after"] .stage__opt--after { background: var(--color-slate); color: var(--color-cloud); }

  .stage__caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-6); margin-top: var(--space-5); }
  .stage__state { font-weight: var(--font-weight-label); color: var(--color-heading); }

  @media (max-width: 767px) {
    .stage__frame { aspect-ratio: 4 / 5; }
    .stage__svg { width: 100%; }
    .stage__frame :global(.stage__img) { object-position: 50% 50%; }
    .stage__control { bottom: var(--space-4); gap: var(--space-2); }
    .stage__control-label { display: none; }
  }
</style>
