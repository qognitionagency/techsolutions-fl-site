---
/** Decorative parallax video band (art-direction §5.2). alt="" and aria-hidden video: no content here. */
import VideoBand from '../ui/VideoBand.astro';
interface Props { slot: string; position?: string }
const { slot, position = '50% 50%' } = Astro.props;
---
<div class="band container-x" data-reveal-group>
  <VideoBand slot={slot} sizes="(min-width: 1440px) 1216px, 100vw" position={position} parallax={10} class="band-frame" />
</div>

<style>
  .band { padding-bottom: var(--space-section); }
  .band :global(.band-frame) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 768px) {
    .band :global(.band-frame) { aspect-ratio: 21 / 9; border-radius: var(--radius-2xl); }
  }
</style>
