---
/**
 * Work gallery (Iron Sound port): staggered grid; each frame clips an over-sized image that
 * drifts on scroll (parallax inside the frame). Every frame is stock, so it carries the visible
 * "Stock image, sample" label (guardrails). The real work is on Instagram (outbound link).
 */
import { anchors, projects } from '../../data/content';
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
---
<section id={anchors.work} class="section gallery" aria-labelledby="work-heading">
  <div class="frame">
    <SectionHead display={projects.display} heading={projects.heading} id="work-heading">
      <p>{projects.intro}</p>
      <Button cta={projects.instagramLink} location="gallery" variant="text" />
    </SectionHead>

    <ul class="grid" role="list">
      {projects.items.map((p) => (
        <li class="item" data-reveal>
          <figure class="item__fig">
            <div class="item__frame">
              <div class="item__plate" data-parallax="6">
                <Img slot={p.slot} alt={p.alt} ratio={4 / 3} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw" class="item__img" />
              </div>
              <span class="item__tag">{p.tag}</span>
              {p.source === 'pexels' && <span class="item__label">{p.label}</span>}
            </div>
            <figcaption class="item__cap">
              <h3 class="item__h3">{p.heading}</h3>
              <p class="item__text">{p.caption}</p>
              <p class="item__credit">{p.credit}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="gallery__cta">
      <Button cta={projects.cta} location="gallery" icon="arrow" />
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--color-bg); }
  .grid { display: grid; gap: var(--space-7) var(--space-5); margin: 0; padding: 0; list-style: none; }
  .item__fig { margin: 0; }
  .item__frame { position: relative; overflow: hidden; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); background: var(--color-mist); box-shadow: var(--shadow-sm); }
  .item__plate { position: absolute; inset: -8% 0; }
  .item__plate :global(picture), .item__plate :global(.item__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .item__frame :global(.item__img) { transition: transform var(--duration-scene) var(--ease-out-expo); }
  .item:hover .item__frame :global(.item__img) { transform: scale(1.03); }
  .item__tag, .item__label {
    position: absolute;
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-surface-glass-strong);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: var(--text-xs);
    color: var(--color-slate);
  }
  .item__tag { top: var(--space-3); left: var(--space-3); font-weight: var(--font-weight-label); }
  .item__label { bottom: var(--space-3); left: var(--space-3); font-family: var(--font-mono); }
  .item__cap { display: grid; gap: var(--space-1); padding-top: var(--space-4); }
  .item__h3 { margin: 0; font-size: var(--text-lg); }
  .item__text { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); max-width: 44ch; }
  .item__credit { margin: var(--space-1) 0 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-signal-700); }
  .gallery__cta { margin-top: var(--space-8); }

  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .item:nth-child(even) { margin-top: var(--space-9); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-6); }
    .item:nth-child(even) { margin-top: 0; }
    .item:nth-child(3n + 2) { margin-top: var(--space-9); }
  }
</style>
