---
/**
 * Service area (#service-area; design-spec-v3 §2.7, content.ts serviceArea). The map is
 * a real Google Maps embed (keyless /maps/embed, no API key) framed as a product card, centred
 * on Miami-Dade and Broward so every listed neighborhood from Kendall to Fort Lauderdale is in
 * view. It loads lazily, below the fold. The chip list carries the names for search and screen
 * readers. No radius circle: the radius is NEEDS DATA. Every neighborhood is a sample until Jay
 * confirms his radius (content.ts serviceArea.sample).
 */
import { anchors, serviceArea } from '../../data/content';
import { uiLabels } from '../../data/ui-labels';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';

// Google's own Share → Embed format (the legacy ?output=embed URL 301s to this).
const MAP_SRC = 'https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d459284.35231408966!2d-80.22!3d25.93!3m2!1i1024!2i768!4f13.1!6i10';
---
<section id={anchors.area} class="section section--alt area" aria-labelledby="area-heading">
  <div class="frame grid12 area__grid">
    <div class="area__text">
      <SectionHead eyebrow={serviceArea.eyebrow} heading={serviceArea.heading} display={serviceArea.display} id="area-heading" tag={serviceArea.sample ? uiLabels.sample : undefined} />
      <p class="area__body">{serviceArea.body}</p>
      <ul class="area__counties" role="list">
        {serviceArea.counties.map((c) => <li><Icon name="pin" size={18} />{c}</li>)}
      </ul>
      <p class="eyebrow area__hoods-h">{serviceArea.neighborhoodsLabel}</p>
      <ul class="area__chips" role="list">
        {serviceArea.cities.map((c) => <li class="mono">{c}</li>)}
      </ul>
      <p class="area__note">{serviceArea.outOfAreaNote}</p>
      <div class="area__ctas">
        <Button cta={serviceArea.ask} location="area" />
        <Button cta={serviceArea.secondary} location="area" variant="text" />
      </div>
    </div>

    <figure class="stage area__map" data-reveal>
      <figcaption class="area__bar">
        <span class="area__bar-t"><Icon name="pin" size={16} />{serviceArea.counties.map((c) => c.replace(/ County$/, '')).join(' + ')}</span>
        <span class="mono area__bar-n">{serviceArea.cities.length} {serviceArea.neighborhoodsCountLabel}</span>
      </figcaption>
      <div class="area__gmap">
        <iframe src={MAP_SRC} title={serviceArea.mapLabel} loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox" allowfullscreen></iframe>
      </div>
    </figure>
  </div>
</section>

<style>
  .area__grid { align-items: start; row-gap: var(--space-7); }
  .area__body { margin: 0; max-width: var(--measure); color: var(--color-text-muted); }
  .area__counties { display: grid; gap: var(--space-2); margin: var(--space-5) 0 0; padding: 0; list-style: none; }
  .area__counties li { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-lg); font-weight: var(--font-weight-heading); color: var(--color-heading); }
  .area__counties :global(.icon) { color: var(--color-accent); }
  .area__hoods-h { margin-top: var(--space-6); }
  .area__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-3) 0 0; padding: 0; list-style: none; }
  .area__chips li { padding: 3px var(--space-3); border-radius: var(--radius-pill); background: var(--color-surface); box-shadow: inset 0 0 0 1px var(--color-border); font-size: var(--text-xs); color: var(--color-heading); }
  .area__note { margin: var(--space-5) 0 0; font-size: var(--text-sm); color: var(--color-text-muted); max-width: 46ch; }
  .area__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-6); }

  .area__map { margin: 0; overflow: hidden; }
  .area__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); }
  .area__bar-t { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: var(--font-weight-heading); color: var(--color-heading); }
  .area__bar-t :global(.icon) { color: var(--color-accent); }
  .area__bar-n { font-size: var(--text-xs); color: var(--color-text-muted); white-space: nowrap; }
  .area__gmap { aspect-ratio: 4 / 5; max-height: max(20rem, calc(100svh - var(--nav-height) - 7rem)); width: 100%; background: var(--color-surface-sunken); }
  .area__gmap iframe { display: block; width: 100%; height: 100%; border: 0; }

  @media (max-width: 767px) {
    .area__map { order: -1; }
    .area__gmap { max-height: max(20rem, 70svh); }
  }
  @media (min-width: 1024px) {
    .area__text { grid-column: 1 / span 5; }
    .area__map { grid-column: 6 / -1; position: sticky; top: calc(var(--nav-height) + var(--space-6)); }
  }
</style>
