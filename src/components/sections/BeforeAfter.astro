---
/**
 * Before/after drag slider (art-direction §5.4, cro-spec row 7).
 * One "after" photo; the "before" is an SVG overlay on the same frame: four
 * cords (TV power, two HDMI runs, set-top box power) hanging to an outlet, plus
 * a set-top box. The slider wipes the overlay; motion.ts scrubs an intro wipe and
 * draws the cords in on scroll. Keyboard: role="slider", arrows/Home/End/PageUp/PageDown.
 * Coordinates are on the photo's 900x600 grid (TV x205–670 y52–320, bench top y418).
 */
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import { beforeAfter as ba } from '../../data/content';

const cords = [
  // TV power: down the wall, over the bench edge, to the outlet
  'M470 321 C468 368 498 400 530 421 C546 431 556 446 561 468 L564 487',
  // HDMI: TV to set-top box, sagging
  'M492 321 C494 366 556 378 600 398',
  // HDMI: TV to soundbar
  'M440 321 C438 356 420 380 421 404',
  // Set-top box power: off the back of the bench, looping down to the outlet
  'M652 410 C694 418 690 458 650 470 C618 479 592 478 578 488',
];
---
<section class="ba section-y" id={ba.id} aria-labelledby="ba-h2">
  <div class="container-x ba-grid">
    <header class="ba-head">
      <h2 id="ba-h2" class="h-section" data-split>{ba.h2}</h2>
      <p class="lede">{ba.body}</p>
      <p class="ba-note">{ba.wallNote}</p>
      <!-- NEEDS DATA: Jay's concrete method -->
    </header>

    <figure class="ba-figure">
      <div class="ba-frame" data-ba style="--pos: 50%">
        <Img slot="signature-tv-wall-after" alt={ba.afterAlt} sizes="(min-width: 1440px) 1216px, 94vw" widths={[640, 960, 1280, 1600, 2000]} class="ba-img" />

        <div class="ba-before" data-ba-before>
          <svg class="ba-svg" viewBox="0 0 900 600" role="img" aria-label={ba.beforeAlt} preserveAspectRatio="xMidYMid slice">
            <defs>
              <filter id="ba-soft" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="3" /></filter>
            </defs>
            <!-- outlet -->
            <rect class="outlet" x="556" y="476" width="30" height="40" rx="3" />
            <rect class="outlet-slot" x="565" y="485" width="3" height="8" rx="1" />
            <rect class="outlet-slot" x="574" y="485" width="3" height="8" rx="1" />
            <rect class="outlet-slot" x="565" y="500" width="3" height="8" rx="1" />
            <rect class="outlet-slot" x="574" y="500" width="3" height="8" rx="1" />
            <!-- set-top box on the bench -->
            <rect class="box-shadow" x="594" y="402" width="66" height="20" rx="3" filter="url(#ba-soft)" />
            <rect class="box" x="590" y="396" width="66" height="22" rx="3" />
            <circle class="box-led" cx="646" cy="407" r="1.8" />
            <!-- cord shadows on the wall -->
            <g class="cord-shadows" filter="url(#ba-soft)" transform="translate(5 7)">
              {cords.map((d) => <path d={d} />)}
            </g>
            <g class="cords">
              {cords.map((d) => <path d={d} pathLength="1" data-cord />)}
            </g>
            <!-- plugs at the outlet -->
            <rect class="plug" x="559" y="482" width="11" height="13" rx="2" />
            <rect class="plug" x="572" y="482" width="11" height="13" rx="2" />
          </svg>
        </div>

        <span class="ba-label ba-label-before" aria-hidden="true">{ba.beforeLabel}</span>
        <span class="ba-label ba-label-after" aria-hidden="true">{ba.afterLabel}</span>

        <div class="ba-divider" aria-hidden="true"></div>
        <div
          class="ba-handle"
          role="slider"
          tabindex="0"
          aria-label={ba.sliderAriaLabel}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-valuetext={`${ba.beforeLabel} 50%`}
          data-ba-handle
          data-label-before={ba.beforeLabel}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5M15 7l5 5-5 5" /></svg>
        </div>
      </div>
      <figcaption class="ba-caption">
        <span class="sample-tag">{ba.caption}</span>
        <!-- NEEDS DATA: real before/after pair from Jay -->
        <Button link={ba.cta} variant="book" size="lg" magnetic service="tv" prefill={{ services: 'tv', wires: 'in_wall' }} data-entry="section" />
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { track } from '../../scripts/analytics';

  const frame = document.querySelector<HTMLElement>('[data-ba]');
  const handle = frame?.querySelector<HTMLElement>('[data-ba-handle]');
  if (frame && handle) {
    let used = false;
    const label = handle.dataset.labelBefore ?? '';

    const set = (pct: number) => {
      const p = Math.max(0, Math.min(100, pct));
      frame.style.setProperty('--pos', `${p}%`);
      const r = Math.round(p);
      handle.setAttribute('aria-valuenow', String(r));
      handle.setAttribute('aria-valuetext', `${label} ${r}%`);
    };
    const firstUse = (method: 'pointer' | 'keyboard') => {
      frame.dataset.user = '';
      if (used) return;
      used = true;
      track('slider_use', { method });
    };
    const fromX = (x: number) => {
      const b = frame.getBoundingClientRect();
      set(((x - b.left) / b.width) * 100);
    };

    // motion.ts drives the intro wipe through this event until the visitor takes over.
    frame.addEventListener('ba:set', (e) => {
      if (!('user' in frame.dataset)) set((e as CustomEvent<number>).detail);
    });

    frame.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      firstUse('pointer');
      frame.setPointerCapture(e.pointerId);
      frame.dataset.dragging = '';
      fromX(e.clientX);
      handle.focus({ preventScroll: true });
    });
    frame.addEventListener('pointermove', (e) => 'dragging' in frame.dataset && fromX(e.clientX));
    const end = () => delete frame.dataset.dragging;
    frame.addEventListener('pointerup', end);
    frame.addEventListener('pointercancel', end);

    handle.addEventListener('keydown', (e) => {
      const now = Number(handle.getAttribute('aria-valuenow'));
      const step: Record<string, number> = { ArrowLeft: -2, ArrowDown: -2, ArrowRight: 2, ArrowUp: 2, PageDown: -10, PageUp: 10 };
      let next: number | null = null;
      if (e.key in step) next = now + step[e.key]!;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = 100;
      if (next === null) return;
      e.preventDefault();
      firstUse('keyboard');
      frame.dataset.snap = '';
      set(next);
      setTimeout(() => delete frame.dataset.snap, 300);
    });
  }
</script>

<style>
  .ba { background: var(--color-surface); border-block: 1px solid var(--color-border); }
  .ba-grid { display: grid; gap: var(--space-7); }
  .ba-head { display: grid; gap: var(--space-4); }
  .ba-head .lede, .ba-note { margin: 0; }
  .ba-note { font-size: var(--text-sm); color: var(--color-text-muted); max-width: 52ch; padding-left: var(--space-4); border-left: 2px solid var(--color-bay); }

  .ba-figure { margin: 0; display: grid; gap: var(--space-5); }
  .ba-frame {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: var(--color-mist);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
  }
  .ba-frame :global(picture), .ba-frame :global(.ba-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-frame[data-snap] .ba-before, .ba-frame[data-snap] .ba-divider, .ba-frame[data-snap] .ba-handle {
    transition: all var(--duration-base) var(--ease-in-out);
  }
  .ba-svg { width: 100%; height: 100%; }
  .ba-svg .cords path { fill: none; stroke: var(--color-slate); stroke-width: 3.2; stroke-linecap: round; }
  .ba-svg .cord-shadows path { fill: none; stroke: color-mix(in srgb, var(--color-slate) 22%, transparent); stroke-width: 4; stroke-linecap: round; }
  .ba-svg .outlet { fill: var(--color-surface); stroke: var(--color-mist-strong); stroke-width: 1.5; }
  .ba-svg .outlet-slot { fill: var(--color-steel); }
  .ba-svg .plug { fill: var(--color-slate); }
  .ba-svg .box { fill: var(--color-slate); }
  .ba-svg .box-shadow { fill: color-mix(in srgb, var(--color-slate) 30%, transparent); }
  .ba-svg .box-led { fill: var(--color-bay); }

  .ba-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    transform: translateX(-1px);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-slate) 12%, transparent);
    pointer-events: none;
  }
  .ba-handle {
    position: absolute;
    top: 50%;
    left: var(--pos);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: calc(var(--spacing) * 14);
    height: calc(var(--spacing) * 14);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-signal-600);
    box-shadow: var(--shadow-md);
    cursor: grab;
    transition: transform var(--duration-base) var(--ease-spring);
  }
  .ba-handle:hover, .ba-frame[data-dragging] .ba-handle { transform: translate(-50%, -50%) scale(1.06); }
  .ba-frame[data-dragging] .ba-handle { cursor: grabbing; }
  .ba-handle:focus-visible { outline: none; box-shadow: var(--shadow-md), var(--shadow-focus); }
  .ba-handle svg { width: var(--space-5); height: var(--space-5); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .ba-label {
    position: absolute;
    top: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    box-shadow: var(--shadow-xs);
    pointer-events: none;
  }
  .ba-label-before { left: var(--space-4); }
  .ba-label-after { right: var(--space-4); }

  .ba-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .ba-caption .sample-tag { white-space: normal; line-height: 1.4; text-transform: none; letter-spacing: 0; }

  @media (min-width: 1024px) {
    .ba-head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--space-8); align-items: end; }
    .ba-head .h-section { grid-row: span 2; }
    .ba-frame { border-radius: var(--radius-2xl); }
  }
</style>
