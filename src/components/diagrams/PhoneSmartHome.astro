---
/**
 * D. Smart home (design-spec-v3 §3.7-D): the diagram is an interactive phone. The scene chips
 * ARE the panel's mode radios (content.ts toggle: Away / Guest arriving / Good night), so the
 * same [data-modes] CSS swaps the tile values. Tiles: content.ts state labels (lock,
 * thermostat, lamps) with their per-scene value. Real controls, keyboard reachable, labelled by
 * the fieldset legend; the tiles are plain text the screen reader reads in order.
 */
import type { DiagramState, Option } from '../../data/content';
import PhoneMock from '../ui/PhoneMock.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  name: string;
  toggle: { label: string; options: readonly Option[] };
  states: Record<string, DiagramState>;
}
const { name, toggle, states } = Astro.props;
const modes = toggle.options.map((o) => o.key);
const first = states[modes[0]!]!;
const ICON: Record<string, 'lock' | 'thermostat' | 'light'> = { lock: 'lock', thermostat: 'thermostat', lamps: 'light' };
---
<div class="psh">
  <PhoneMock width="16.25rem">
    <div class="psh__screen">
      <fieldset class="psh__scenes">
        <legend class="psh__legend">{toggle.label}</legend>
        <div class="psh__chips">
          {toggle.options.map((o, i) => (
            <label class="psh__chip">
              <input type="radio" name={name} value={o.key} data-mode-i={i} data-mode={o.key} checked={i === 0} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <ul class="psh__tiles" role="list">
        {first.labels.map((l) => (
          <li class:list={['psh__tile', l.id === 'thermostat' && 'psh__tile--temp']} data-tile>
            <span class="psh__ico"><Icon name={ICON[l.id] ?? 'home'} size={20} /></span>
            <span class="psh__name">{l.text}</span>
            {modes.map((m, i) => {
              const v = states[m]?.labels.find((x) => x.id === l.id);
              return v?.value ? (
                <span class:list={['psh__val', l.id === 'thermostat' && 'mono']} data-in-mode={String(i)}>{v.value}</span>
              ) : null;
            })}
          </li>
        ))}
      </ul>
    </div>
  </PhoneMock>
</div>

<style>
  .psh { display: grid; place-items: center; padding-block: var(--space-4); }
  /* Size the device to its content: a fixed phone aspect left a dead third under the tiles. */
  .psh :global(.device) { aspect-ratio: auto; }
  .psh :global(.device__screen) { height: auto; }
  .psh__screen { display: grid; gap: var(--space-4); padding: var(--space-2) var(--space-4) var(--space-7); }
  .psh__scenes { margin: 0; padding: 0; border: 0; min-width: 0; }
  .psh__legend { padding: 0; margin-bottom: var(--space-2); font-size: var(--text-xs); font-weight: var(--font-weight-label); color: var(--color-text-muted); }
  .psh__chips { display: grid; gap: var(--space-2); }
  .psh__chip { position: relative; display: block; }
  .psh__chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .psh__chip span {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-label);
    color: var(--color-heading);
    transition: background-color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .psh__chip:hover span { background: var(--color-bg-alt); }
  .psh__chip input:checked + span { border-color: var(--color-accent); background: var(--color-surface-tint); color: var(--color-link-hover); box-shadow: inset 0 0 0 0.5px var(--color-accent); }
  .psh__chip input:focus-visible + span { outline: 2px solid var(--color-focus); outline-offset: 2px; }

  .psh__tiles { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .psh__tile {
    display: grid;
    align-content: start;
    gap: 2px;
    min-height: 5.5rem;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
    box-shadow: inset 0 0 0 1px var(--color-border);
    transition: box-shadow var(--duration-slow) var(--ease-out-expo);
  }
  .psh__tile:last-child:nth-child(odd) { grid-column: 1 / -1; min-height: 0; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-3); }
  .psh__tile:last-child:nth-child(odd) .psh__ico { margin: 0; }
  .psh__tile.is-flash { box-shadow: inset 0 0 0 1.5px var(--color-accent); }
  .psh__ico { color: var(--color-heading); margin-bottom: var(--space-2); }
  .psh__name { font-size: var(--text-xs); color: var(--color-text-muted); line-height: var(--leading-ui); }
  .psh__val { font-size: var(--text-sm); font-weight: var(--font-weight-heading); color: var(--color-heading); line-height: var(--leading-ui); }
  .psh__tile--temp .psh__val { font-size: var(--text-xl); font-weight: var(--font-weight-data); letter-spacing: -0.02em; }
</style>
