---
/**
 * Single-family lot drawn once in plan units (lot 100..660 × 30..420, street below, neighbour
 * strip to the right). Used by both DiagramCameraPlan artboards (mobile = rotated by the parent).
 * Cones are sector paths clipped to the lot: the drawing's proof of "aimed at your property,
 * not next door" (spec §3.7-C). Each cone grows from its camera point when its mode is active.
 */
export interface Cam {
  id: string;
  x: number;
  y: number;
  /** facing, degrees (0 = east, 90 = south in SVG space) */
  dir: number;
  spread: number;
  range: number;
  /** space-separated mode indexes in which this camera exists */
  modes: string;
}
interface Props {
  p: string;
  cams: Cam[];
  /** mode indexes in which the side-gate zone is a blind spot */
  blindIn: string;
}
const { p, cams, blindIn } = Astro.props;
const rad = (d: number) => (d * Math.PI) / 180;
const sector = (c: Cam) => {
  const a0 = rad(c.dir - c.spread / 2);
  const a1 = rad(c.dir + c.spread / 2);
  const p0 = [c.x + c.range * Math.cos(a0), c.y + c.range * Math.sin(a0)];
  const p1 = [c.x + c.range * Math.cos(a1), c.y + c.range * Math.sin(a1)];
  return `M${c.x} ${c.y} L${p0[0]!.toFixed(1)} ${p0[1]!.toFixed(1)} A${c.range} ${c.range} 0 0 1 ${p1[0]!.toFixed(1)} ${p1[1]!.toFixed(1)} Z`;
};
const hatch = Array.from({ length: 16 }, (_, i) => `M${104 + i * 8} 150 L${104 + i * 8 - 40} 250`).join(' ');
---
<defs>
  <clipPath id={`${p}-lot`}><rect x="100" y="30" width="560" height="390" /></clipPath>
  <clipPath id={`${p}-gate`}><rect x="100" y="150" width="100" height="100" /></clipPath>
</defs>
<!-- neighbour strip + street -->
<rect x="660" y="30" width="116" height="390" class="cmp__neighbor" />
<rect x="24" y="420" width="752" height="56" class="cmp__street" />
<!-- lot -->
<rect x="100" y="30" width="560" height="390" class="cmp__lot" />
<!-- patio, walk, driveway, pool -->
<rect x="250" y="46" width="190" height="62" rx="2" class="cmp__paved" />
<rect x="320" y="290" width="26" height="130" class="cmp__paved" />
<rect x="492" y="290" width="92" height="130" class="cmp__paved" />
<!-- house + garage -->
<path d="M200 110 H480 V170 H590 V290 H200 Z" class="cmp__house" />
<path d="M480 170 V290 M200 200 H330 M330 110 V290 M400 110 V200" class="cmp__inner" />
<!-- side fence with gate -->
<path d="M100 200 H128 M172 200 H200" class="cmp__fence" />
<path d="M128 200 A44 44 0 0 1 172 200" class="cmp__fine" />
<!-- blind spot: the side gate zone, hatched -->
<g data-fade-mode={blindIn}>
  <rect x="100" y="150" width="100" height="100" class="cmp__blind" />
  <path d={hatch} clip-path={`url(#${p}-gate)`} class="cmp__blind-hatch" />
</g>
<!-- cones -->
<g clip-path={`url(#${p}-lot)`}>
  {cams.map((c) => (
    <g data-fade-mode={c.modes}>
      <path d={sector(c)} class="cmp__cone" style={`transform-origin:${c.x}px ${c.y}px`} />
    </g>
  ))}
</g>
<!-- cameras -->
{cams.map((c) => (
  <g data-fade-mode={c.modes}>
    <line x1={c.x} y1={c.y} x2={c.x + 13 * Math.cos(rad(c.dir))} y2={c.y + 13 * Math.sin(rad(c.dir))} class="cmp__stub" />
    <circle cx={c.x} cy={c.y} r="6" class="cmp__cam" />
  </g>
))}
<!-- property line -->
<rect x="100" y="30" width="560" height="390" class="cmp__propline" />
