---
/** Composes sections only. No copy, no logic. Order and backgrounds: design-spec-v3 §0. */
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import ServiceExplorer from '../components/sections/ServiceExplorer.astro';
import QuoteBuilder from '../components/sections/QuoteBuilder.astro';
import Process from '../components/sections/Process.astro';
import BuiltFor from '../components/sections/BuiltFor.astro';
import Reviews from '../components/sections/Reviews.astro';
import ServiceArea from '../components/sections/ServiceArea.astro';
import Faq from '../components/sections/Faq.astro';
import Consult from '../components/sections/Consult.astro';
import Footer from '../components/sections/Footer.astro';
import MobileBar from '../components/sections/MobileBar.astro';
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <ServiceExplorer />
    <QuoteBuilder />
    <Process />
    <BuiltFor />
    <Reviews />
    <ServiceArea />
    <Faq />
    <Consult />
  </main>
  <Footer />
  <MobileBar />
</Base>
<script>
  import '../scripts/phone';
</script>
